+namespace {
+
+/// Whether a view holds a typed cell edit.
+bool HasTypedCellEdit( const ScDocShell& rShell )
+{
+    for (SfxViewFrame* pFrame = SfxViewFrame::GetFirst(&rShell, false); pFrame;
+         pFrame = SfxViewFrame::GetNext(*pFrame, &rShell, false))
+    {
+        auto pViewSh = dynamic_cast<ScTabViewShell*>(pFrame->GetViewShell());
+        ScInputHandler* pHdl = pViewSh ? pViewSh->GetInputHandler() : nullptr;
+        if (pHdl && pHdl->IsInputMode() && pHdl->IsModified())
+            return true;
+    }
+    return false;
+}
+
+}
+
 void ScDocShell::SetModified( bool bModified )
 {
+    // A typed cell edit keeps the document modified.
+    if ( !bModified && comphelper::LibreOfficeKit::isActive() && HasTypedCellEdit( *this ) )
+        return;
     if ( SfxObjectShell::IsEnableSetModified() )
     {
         SfxObjectShell::SetModified( bModified );
