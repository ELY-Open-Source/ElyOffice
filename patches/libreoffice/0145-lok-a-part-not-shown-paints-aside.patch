+bool SdXImpressDocument::setPaintPart(int nPart, int nMode)
+{
+    mpPaintPage = nullptr;
+    if (nPart < 0)
+        return true;
+    if (!mpDoc || !GetViewShell())
+        return false;
+    if (nMode == 0 && nPart < mpDoc->GetSdPageCount(PageKind::Standard))
+        mpPaintPage = mpDoc->GetSdPage(nPart, PageKind::Standard);
+    else if (nMode == 1 && nPart < mpDoc->GetMasterSdPageCount(PageKind::Standard))
+        mpPaintPage = mpDoc->GetMasterSdPage(nPart, PageKind::Standard);
+    else if (nMode == 2 && nPart < mpDoc->GetSdPageCount(PageKind::Notes))
+        mpPaintPage = mpDoc->GetSdPage(nPart, PageKind::Notes);
+    return mpPaintPage != nullptr;
+}
