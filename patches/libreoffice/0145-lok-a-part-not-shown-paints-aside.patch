+/// Ely: paints a part not shown on its own view.
+void paintPartAside(DrawViewShell& rShell, ::sd::DrawDocShell& rDocShell, SdPage& rPage,
+                    VirtualDevice& rDevice, const ::tools::Rectangle& rRect)
+{
+    const SdrView& rShown = *rShell.GetDrawView();
+    ::sd::DrawView aView(&rDocShell, &rDevice, nullptr);
+    aView.SetPageVisible(rShown.IsPageVisible());
+    aView.SetPageBorderVisible(rShown.IsPageBorderVisible());
+    aView.SetBordVisible(rShown.IsBordVisible());
+    aView.SetGridVisible(rShown.IsGridVisible());
+    aView.SetGridFront(rShown.IsGridFront());
+    aView.SetGridCoarse(rShown.GetGridCoarse());
+    aView.SetGridFine(rShown.GetGridFine());
+    aView.SetHlplVisible(rShown.IsHlplVisible());
+    SdrPageView* pPageView = aView.ShowSdrPage(&rPage);
+    if (!pPageView)
+        return;
+    pPageView->SetApplicationDocumentColor(rShell.GetViewOptions().mnDocBackgroundColor);
+    if (const SdrPageView* pShownPage = rShown.GetSdrPageView())
+    {
+        pPageView->SetVisibleLayers(pShownPage->GetVisibleLayers());
+        pPageView->SetPrintableLayers(pShownPage->GetPrintableLayers());
+        pPageView->SetLockedLayers(pShownPage->GetLockedLayers());
+        pPageView->SetHelpLines(pShownPage->GetHelpLines());
+    }
+    aView.CompleteRedraw(&rDevice, vcl::Region(rRect));
+    aView.HideSdrPage();
+}
+}
