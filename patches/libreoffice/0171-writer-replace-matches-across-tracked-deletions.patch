+/// Whether any level of rRedline deletes, as format on delete.
+static bool lcl_Deletes(SwRangeRedline const& rRedline)
+{
+    for (sal_uInt16 n = 0; n < rRedline.GetStackCount(); ++n)
+    {
+        if (rRedline.GetType(n) == RedlineType::Delete)
+            return true;
+    }
+    return false;
+}
+
+/// Shown deleted text of rNd within [nStart, nEnd), in order.
+static std::vector<std::pair<AmbiguousIndex, AmbiguousIndex>>
+lcl_ShownDeletions(const SwTextNode& rNd, SwTextFrame const*const pFrame,
+                   SwRootFrame const*const pLayout,
+                   AmbiguousIndex const nStart, AmbiguousIndex const nEnd)
+{
+    std::vector<std::pair<AmbiguousIndex, AmbiguousIndex>> aRet;
+    if (pLayout && pLayout->IsHideRedlines())
+        return aRet; // the merged text holds no deleted text
+    IDocumentRedlineAccess const& rIDRA(rNd.GetDoc().getIDocumentRedlineAccess());
+    SwRedlineTable const& rTable(rIDRA.GetRedlineTable());
+    SwRedlineTable::size_type n(0);
+    rIDRA.GetRedline(SwPosition(rNd, 0), &n);
+    for (; n < rTable.size(); ++n)
+    {
+        SwRangeRedline const& rRedline(*rTable[n]);
+        if (rNd.GetIndex() < rRedline.Start()->GetNodeIndex())
+            break;
+        if (rRedline.End()->GetNodeIndex() < rNd.GetIndex() || !lcl_Deletes(rRedline))
+            continue;
+        sal_Int32 const nFrom(rRedline.Start()->GetNodeIndex() < rNd.GetIndex()
+            ? 0 : rRedline.Start()->GetContentIndex());
+        sal_Int32 const nTo(rNd.GetIndex() < rRedline.End()->GetNodeIndex()
+            ? rNd.Len() : rRedline.End()->GetContentIndex());
+        AmbiguousIndex aFrom;
+        AmbiguousIndex aTo;
+        if (pLayout)
+        {
+            aFrom.SetFrameIndex(pFrame->MapModelToView(&rNd, nFrom));
+            aTo.SetFrameIndex(pFrame->MapModelToView(&rNd, nTo));
+        }
+        else
+        {
+            aFrom.SetModelIndex(nFrom);
+            aTo.SetModelIndex(nTo);
+        }
+        if (aFrom < nStart)
+            aFrom = nStart;
+        if (nEnd < aTo)
+            aTo = nEnd;
+        if (aFrom < aTo)
+            aRet.emplace_back(aFrom, aTo);
+    }
+    return aRet;
+}
+
+/// Where pHint starts, or -1 without one.
+static AmbiguousIndex lcl_HintStart(SwTextFrame const*const pFrame,
+        SwRootFrame const*const pLayout,
+        SwTextNode const*const pNode, SwTextAttr const*const pHint)
+{
+    AmbiguousIndex nRet;
+    if (pLayout)
+    {
+        nRet.SetFrameIndex(pHint
+                ? pFrame->MapModelToView(pNode, pHint->GetStart())
+                : TextFrameIndex(-1));
+    }
+    else
+    {
+        nRet.SetModelIndex(pHint ? pHint->GetStart() : -1);
+    }
+    return nRet;
+}
