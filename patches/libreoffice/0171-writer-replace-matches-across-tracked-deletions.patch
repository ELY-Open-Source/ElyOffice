+/// Ely: whether any level of rRedline deletes.
+bool lcl_ElyDeletes(const SwRangeRedline& rRedline)
+{
+    for (sal_uInt16 n = 0; n < rRedline.GetStackCount(); ++n)
+    {
+        if (rRedline.GetType(n) == RedlineType::Delete)
+            return true;
+    }
+    return false;
+}
+
+/// Ely: rText without tracked deletions; rAt maps chars back.
+OUString lcl_ElyKeptText(const SwTextNode& rText, std::vector<sal_Int32>& rAt)
+{
+    const OUString& rAll = rText.GetText();
+    std::vector<bool> aGone(rAll.getLength(), false);
+    const IDocumentRedlineAccess& rIDRA = rText.GetDoc().getIDocumentRedlineAccess();
+    const SwRedlineTable& rTable = rIDRA.GetRedlineTable();
+    SwRedlineTable::size_type n = 0;
+    rIDRA.GetRedline(SwPosition(rText, 0), &n);
+    for (; n < rTable.size(); ++n)
+    {
+        const SwRangeRedline& rRedline = *rTable[n];
+        if (rText.GetIndex() < rRedline.Start()->GetNodeIndex())
+            break;
+        if (rRedline.End()->GetNodeIndex() < rText.GetIndex() || !lcl_ElyDeletes(rRedline))
+            continue;
+        const sal_Int32 nFrom = rRedline.Start()->GetNodeIndex() < rText.GetIndex() ? 0 : rRedline.Start()->GetContentIndex();
+        const sal_Int32 nTo = rText.GetIndex() < rRedline.End()->GetNodeIndex() ? rAll.getLength() : rRedline.End()->GetContentIndex();
+        for (sal_Int32 i = nFrom; i < nTo; ++i)
+            aGone[i] = true;
+    }
+    OUStringBuffer aKept(rAll.getLength());
+    rAt.clear();
+    for (sal_Int32 i = 0; i < rAll.getLength(); ++i)
+    {
+        if (aGone[i])
+            continue;
+        aKept.append(rAll[i]);
+        rAt.push_back(i);
+    }
+    return aKept.makeStringAndClear();
+}
