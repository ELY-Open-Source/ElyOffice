+/// Ely: one item for each script.
+template <class Item, class Value>
+void lcl_ElyPutScripts(SfxItemSet& rSet, std::initializer_list<sal_uInt16> aWhich, const Value& rValue)
+{
+    for (const sal_uInt16 nWhich : aWhich)
+        rSet.Put(Item(rValue, nWhich));
+}
+
+/// Ely: `rFormats`' seven tab-separated fields; empty leaves one alone.
+bool lcl_ElyFormats(SwDoc& rDoc, const OUString& rFormats, SfxItemSet& rSet, SwTextFormatColl*& rColl)
+{
+    std::vector<OUString> aField;
+    sal_Int32 nIndex = 0;
+    do
+        aField.emplace_back(o3tl::getToken(rFormats, 0, '\t', nIndex));
+    while (nIndex >= 0);
+    if (aField.size() != 7)
+        return false;
+    if (!aField[0].isEmpty())
+        lcl_ElyPutScripts<SvxWeightItem>(rSet, { RES_CHRATR_WEIGHT, RES_CHRATR_CJK_WEIGHT, RES_CHRATR_CTL_WEIGHT },
+                                         aField[0] == "on" ? WEIGHT_BOLD : WEIGHT_NORMAL);
+    if (!aField[1].isEmpty())
+        lcl_ElyPutScripts<SvxPostureItem>(rSet, { RES_CHRATR_POSTURE, RES_CHRATR_CJK_POSTURE, RES_CHRATR_CTL_POSTURE },
+                                          aField[1] == "on" ? ITALIC_NORMAL : ITALIC_NONE);
+    if (!aField[2].isEmpty())
+        rSet.Put(SvxUnderlineItem(aField[2] == "on" ? LINESTYLE_SINGLE : LINESTYLE_NONE, RES_CHRATR_UNDERLINE));
+    if (!aField[3].isEmpty())
+        for (const sal_uInt16 nWhich : { RES_CHRATR_FONT, RES_CHRATR_CJK_FONT, RES_CHRATR_CTL_FONT })
+            rSet.Put(SvxFontItem(FAMILY_DONTKNOW, aField[3], OUString(), PITCH_DONTKNOW, RTL_TEXTENCODING_DONTKNOW, nWhich));
+    if (!aField[4].isEmpty())
+    {
+        const sal_uInt32 nTwips = aField[4].toUInt32();
+        if (nTwips == 0)
+            return false;
+        for (const sal_uInt16 nWhich : { RES_CHRATR_FONTSIZE, RES_CHRATR_CJK_FONTSIZE, RES_CHRATR_CTL_FONTSIZE })
+            rSet.Put(SvxFontHeightItem(nTwips, 100, nWhich));
+    }
+    if (!aField[5].isEmpty())
+        rSet.Put(SvxColorItem(aField[5] == "none" ? COL_AUTO : Color(ColorTransparency, aField[5].toUInt32(16)),
+                              RES_CHRATR_COLOR));
+    rColl = nullptr;
+    if (!aField[6].isEmpty())
+    {
+        rColl = lcl_ElyParaStyle(rDoc, aField[6]);
+        if (!rColl)
+            return false;
+    }
+    return rSet.Count() > 0 || rColl;
+}
+
+/// Ely: formats every body match of `rFind`, one undo step.
+bool lcl_ElyFormatMatches(SwDoc& rDoc, const OUString& rFind, const OUString& rFormats)
+{
+    SfxItemSetFixed<RES_CHRATR_BEGIN, RES_CHRATR_END> aSet(rDoc.GetAttrPool());
+    SwTextFormatColl* pColl = nullptr;
+    if (rFind.isEmpty() || !lcl_ElyFormats(rDoc, rFormats, aSet, pColl))
+        return false;
+    // The body only; headers, notes, frames are extras.
+    SwNodes& rNodes = rDoc.GetNodes();
+    std::vector<std::pair<SwTextNode*, sal_Int32>> aHits;
+    for (SwNodeOffset n = rNodes.GetEndOfExtras().GetIndex() + 1; n < rNodes.GetEndOfContent().GetIndex(); ++n)
+    {
+        SwTextNode* pText = rNodes[n]->GetTextNode();
+        if (!pText)
+            continue;
+        const OUString& rText = pText->GetText();
+        for (sal_Int32 nAt = rText.indexOf(rFind); nAt >= 0; nAt = rText.indexOf(rFind, nAt + rFind.getLength()))
+            aHits.emplace_back(pText, nAt);
+    }
+    // No match changes nothing.
+    if (aHits.empty())
+        return false;
+    IDocumentContentOperations& rOps = rDoc.getIDocumentContentOperations();
+    rDoc.GetIDocumentUndoRedo().StartUndo(SwUndoId::INSATTR, nullptr);
+    for (const auto& [pText, nAt] : aHits)
+    {
+        const SwPaM aMatch(*pText, nAt, *pText, nAt + rFind.getLength());
+        if (aSet.Count())
+            rOps.InsertItemSet(aMatch, aSet);
+        if (pColl)
+            rDoc.SetTextFormatColl(aMatch, pColl, true, false);
+    }
+    rDoc.GetIDocumentUndoRedo().EndUndo(SwUndoId::INSATTR, nullptr);
+    return true;
+}
 }
 
