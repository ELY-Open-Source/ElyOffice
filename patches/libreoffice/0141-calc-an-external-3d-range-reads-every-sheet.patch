+/// Places a 3D range by its named ends in rSrcDoc.
+void respan(formula::FormulaToken& rToken, const std::vector<OUString>& rOldNames,
+            const ScDocument& rSrcDoc, svl::SharedStringPool& rPool)
+{
+    ScComplexRefData& rRef = *rToken.GetDoubleRef();
+    const SCTAB nSpan = rRef.Ref2.Tab() - rRef.Ref1.Tab();
+    if (nSpan <= 0)
+        return;
+    const OUString aFirst = rToken.GetString().getString();
+    auto itr = std::find_if(rOldNames.begin(), rOldNames.end(),
+        [&aFirst](const OUString& rName) { return rName.equalsIgnoreAsciiCase(aFirst); });
+    SCTAB nFirst, nLast;
+    if (rOldNames.end() - itr <= nSpan || !rSrcDoc.GetTable(aFirst, nFirst) || !rSrcDoc.GetTable(*(itr + nSpan), nLast))
+    {
+        ELY_WARN("sc.ui", "3D range not placed: " << aFirst);
+        return;
+    }
+    if (nLast < nFirst)
+    {
+        std::swap(nFirst, nLast);
+        OUString aName;
+        rSrcDoc.GetName(nFirst, aName);
+        rToken.SetString(rPool.intern(aName));
+    }
+    rRef.Ref2.SetAbsTab(rRef.Ref1.Tab() + nLast - nFirst);
+}
+
