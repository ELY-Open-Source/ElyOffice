+void ScExternalRefManager::recordLookup(sal_uInt16 nFileId, const OUString& rTabName, SCTAB nSpan, const ScAddress& rCurPos)
+{
+    const ScFormulaCell* pCell = mrDoc.GetFormulaCell(rCurPos);
+    if (!pCell)
+        return;
+    std::set<OUString>& rTabs = maLookedUpTabs[nFileId][pCell];
+    rTabs.insert(rTabName);
+    if (nSpan <= 0)
+        return;
+    std::vector<OUString> aNames;
+    maRefCache.getAllTableNames(nFileId, aNames);
+    auto itr = std::find_if(aNames.begin(), aNames.end(),
+        [&rTabName](const OUString& rName) { return rName.equalsIgnoreAsciiCase(rTabName); });
+    // A 3D range reads every sheet up to its last.
+    for (SCTAB i = 0; i < nSpan && itr != aNames.end() && ++itr != aNames.end(); ++i)
+        rTabs.insert(*itr);
+}
