+        {
+            // Ely: this list from here follows the list before.
+            SwWrtShell& rSh = GetShell();
+            OUString sListId;
+            const SwNumRule* pRule = nullptr;
+            if (!ElyJoinable(rSh, sListId, pRule))
+                return;
+            const SwTextNode& rFirst = *ElyNumbered(rSh);
+            SwDoc& rDoc = *rSh.GetDoc();
+            const OUString aOld = rFirst.GetListId();
+            const SwNumRule* pOwn = rFirst.GetNumRule();
+            rSh.StartAllAction();
+            rSh.StartUndo(SwUndoId::INSATTR);
+            rDoc.SetNumRuleStart(SwPosition(rFirst), false);
+            const SwNodes& rNodes = rDoc.GetNodes();
+            for (SwNodeOffset n = rFirst.GetIndex(); pRule && n < rFirst.EndOfSectionIndex(); ++n)
+            {
+                const SwTextNode* pText = rNodes[n]->GetTextNode();
+                if (!pText || !pText->IsInList() || pText->GetListId() != aOld)
+                    continue;
+                const SwPaM aPam(*pText);
+                // An item with its own style keeps it.
+                if (pText->GetNumRule() == pOwn)
+                    rDoc.SetNumRule(aPam, *pRule, SwDoc::SetNumRuleMode::Default, rSh.GetLayout(), sListId);
+                else
+                    rDoc.getIDocumentContentOperations().InsertPoolItem(
+                        aPam, SfxStringItem(RES_PARATR_LIST_ID, sListId));
+            }
+            rSh.EndUndo(SwUndoId::INSATTR);
+            rSh.EndAllAction();
+        }
+        break;
+
