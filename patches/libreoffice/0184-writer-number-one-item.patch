+const SwTextNode* SwTextShell::ElyNumbered(SwWrtShell& rSh)
+{
+    // Ely: the cursor's paragraph when it shows a number.
+    const SwTextNode* pNode = rSh.GetCursor()->GetPoint()->GetNode().GetTextNode();
+    const SwNumRule* pRule = pNode ? pNode->GetNumRule() : nullptr;
+    const int nLevel = pNode ? pNode->GetActualListLevel() : -1;
+    if (!pRule || !pNode->IsCountedInList() || nLevel < 0 || nLevel >= MAXLEVEL)
+        return nullptr;
+    return pRule->Get(o3tl::narrowing<sal_uInt16>(nLevel)).IsEnumeration() ? pNode : nullptr;
+}
+
+bool SwTextShell::ElyJoinable(SwWrtShell& rSh, OUString& rListId, const SwNumRule*& rRule)
+{
+    // Ely: a restart, or a first item after another list.
+    const SwTextNode* pNode = ElyNumbered(rSh);
+    if (!pNode)
+        return false;
+    if (rSh.IsFirstOfNumRuleAtCursorPos())
+    {
+        rRule = rSh.GetDoc()->SearchNumRule(SwPosition(*pNode), false, true, false, -1, rListId,
+                                            rSh.GetLayout());
+        return rRule && rListId != pNode->GetListId();
+    }
+    return rSh.IsNumRuleStart();
+}
