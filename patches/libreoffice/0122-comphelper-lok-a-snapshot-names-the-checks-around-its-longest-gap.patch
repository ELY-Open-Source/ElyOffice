 /// Throws if a snapshot runs and input waits.
-COMPHELPER_DLLPUBLIC void checkSnapshot();
+COMPHELPER_DLLPUBLIC void checkSnapshot(const std::source_location& rWhere = std::source_location::current());
 }
 
