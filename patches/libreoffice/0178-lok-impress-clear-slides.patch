+/// Ely: empties slides by index as one undo step.
+static bool lcl_ElyClearSlides(SdDrawDocument& rDoc, std::u16string_view aSlides)
+{
+    const sal_Int32 nCount = rDoc.GetSdPageCount(PageKind::Standard);
+    std::vector<SdPage*> aPages;
+    sal_Int32 nSlide = -1;
+    for (size_t i = 0; i <= aSlides.size(); ++i)
+    {
+        if (i < aSlides.size() && aSlides[i] >= '0' && aSlides[i] <= '9')
+        {
+            nSlide = (nSlide < 0 ? 0 : nSlide) * 10 + (aSlides[i] - '0');
+            if (nSlide >= nCount)
+                return false;
+            continue;
+        }
+        if ((i < aSlides.size() && aSlides[i] != ';') || nSlide < 0)
+            return false;
+        SdPage* pPage = rDoc.GetSdPage(nSlide, PageKind::Standard);
+        if (std::find(aPages.begin(), aPages.end(), pPage) != aPages.end())
+            return false;
+        aPages.push_back(pPage);
+        nSlide = -1;
+    }
+    rDoc.BegUndo(OUString());
+    for (SdPage* pPage : aPages)
+        // Comments stay, as .uno:SlideObjects leaves them out.
+        for (size_t n = pPage->GetObjCount(); n > 0; --n)
+        {
+            SdrObject* pObj = pPage->GetObj(n - 1);
+            if (pObj->isAnnotationObject())
+                continue;
+            rDoc.AddUndo(rDoc.GetSdrUndoFactory().CreateUndoDeleteObject(*pObj, true));
+            pPage->RemoveObject(n - 1);
+        }
+    rDoc.EndUndo();
+    return true;
+}
