+PhysicalFontFamily* PhysicalFontCollection::FindFontFamilyByAnyName(std::u16string_view rFontName) const
+{
+    const OUString aSearchName = GetEnglishSearchFontName(rFontName);
+    if (PhysicalFontFamily* pFound = ImplFindFontFamilyBySearchName(aSearchName))
+        return pFound;
