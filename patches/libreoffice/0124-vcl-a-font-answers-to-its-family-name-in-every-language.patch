+std::vector<OUString> PhysicalFontFace::GetNames(NameID aNameID) const
+{
+    hb_face_t* pHbFace = GetHbFace();
+    unsigned int nCount = 0;
+    const hb_ot_name_entry_t* pEntries = hb_ot_name_list_names(pHbFace, &nCount);
+    std::vector<OUString> aNames;
+    for (unsigned int i = 0; i < nCount; ++i)
+    {
+        if (pEntries[i].name_id != aNameID)
+            continue;
+        unsigned int nName
+            = hb_ot_name_get_utf16(pHbFace, aNameID, pEntries[i].language, nullptr, nullptr);
+        std::vector<uint16_t> aBuf(++nName);
+        hb_ot_name_get_utf16(pHbFace, aNameID, pEntries[i].language, &nName, aBuf.data());
+        aNames.emplace_back(reinterpret_cast<sal_Unicode*>(aBuf.data()), nName);
+    }
+    return aNames;
+}
