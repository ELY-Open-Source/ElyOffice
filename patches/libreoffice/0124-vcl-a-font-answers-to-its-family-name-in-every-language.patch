+// The face's family, as the document names it.
+static OUString UsedFamilyName(const vcl::font::PhysicalFontFace* face, const OUString& requested)
+{
+    const OUString family = face->GetFamilyName();
+    const OUString familySearch = GetEnglishSearchFontName(family);
+    sal_Int32 index = 0;
+    do
+    {
+        const OUString token = requested.getToken(0, ';', index);
+        const OUString search = GetEnglishSearchFontName(token);
+        if (search == familySearch)
+            return family;
+        for (vcl::font::NameID id : { vcl::font::NAME_ID_FONT_FAMILY, vcl::font::NAME_ID_TYPOGRAPHIC_FAMILY })
+            for (const OUString& name : face->GetNames(id))
+                if (GetEnglishSearchFontName(name) == search)
+                    return token;
+    } while (index >= 0);
+    return family;
+}
