+PhysicalFontFamily* PhysicalFontCollection::ImplFindFontFamilyByOtherName(const OUString& rSearchName) const
+{
+    if (!mbOtherNames)
+    {
+        mbOtherNames = true;
+        const auto aStart = std::chrono::steady_clock::now();
+        std::vector<PhysicalFontFamily*> aFamilies;
+        for (auto const& family : maPhysicalFontFamilies)
+            aFamilies.push_back(family.second.get());
+        // Sorted, so a shared name always picks one family.
+        std::sort(aFamilies.begin(), aFamilies.end(),
+                  [](const PhysicalFontFamily* a, const PhysicalFontFamily* b)
+                  { return a->GetSearchName() < b->GetSearchName(); });
+        for (NameID aNameID : { NAME_ID_FONT_FAMILY, NAME_ID_TYPOGRAPHIC_FAMILY })
+            for (PhysicalFontFamily* pFamily : aFamilies)
+                for (const OUString& rName : pFamily->GetNames(aNameID))
+                {
+                    OUString aName = GetEnglishSearchFontName(rName);
+                    if (!maPhysicalFontFamilies.contains(aName))
+                        maOtherNames.emplace(aName, pFamily);
+                }
+        ELY_INFO("vcl.fonts", "read " << maOtherNames.size() << " other names of "
+                                      << aFamilies.size() << " font families in "
+                                      << std::chrono::duration_cast<std::chrono::milliseconds>(
+                                             std::chrono::steady_clock::now() - aStart)
+                                             .count()
+                                      << " ms");
+    }
+    auto it = maOtherNames.find(rSearchName);
+    return it == maOtherNames.end() ? nullptr : it->second;
+}
