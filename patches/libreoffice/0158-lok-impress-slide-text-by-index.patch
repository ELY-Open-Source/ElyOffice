+SdrTextObj* DrawViewShell::ElyBox(SdDrawDocument& rDoc, sal_uInt16 nSlide, std::u16string_view aBox)
+{
+    if (aBox == u"notes")
+        return dynamic_cast<SdrTextObj*>(rDoc.GetSdPage(nSlide, PageKind::Notes)->GetPresObj(PresObjKind::Notes));
+    SdPage* pPage = rDoc.GetSdPage(nSlide, PageKind::Standard);
+    SdrObject* pObj = nullptr;
+    if (aBox == u"title")
+        pObj = pPage->GetPresObj(PresObjKind::Title);
+    else if (aBox == u"body")
+    {
+        // A title slide's subtitle is its body.
+        pObj = pPage->GetPresObj(PresObjKind::Outline);
+        if (!pObj)
+            pObj = pPage->GetPresObj(PresObjKind::Text);
+    }
+    return dynamic_cast<SdrTextObj*>(pObj);
+}
