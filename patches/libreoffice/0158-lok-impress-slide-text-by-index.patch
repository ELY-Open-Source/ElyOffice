+/// Sets a slide's title or body, keeping its look.
+bool lcl_ElySlideText(SdDrawDocument& rDoc, sal_Int32 nSlide, std::u16string_view aBox, const OUString& rText)
+{
+    if (nSlide < 0 || nSlide >= rDoc.GetSdPageCount(PageKind::Standard) || aBox == u"notes")
+        return false;
+    SdrTextObj* pObj = sd::DrawViewShell::ElyBox(rDoc, static_cast<sal_uInt16>(nSlide), aBox);
+    if (!pObj)
+        return false;
+    SdPage* pPage = static_cast<SdPage*>(pObj->getSdrPageFromSdrObject());
+    const PresObjKind eKind = pPage->GetPresObjKind(pObj);
+    const OutlinerParaObject* pOld = !pObj->IsEmptyPresObj() ? pObj->GetOutlinerParaObject() : nullptr;
+    std::optional<SfxItemSet> oLook = pOld
+        ? sd::DrawViewShell::NotesLook(pOld->GetTextObject(), rDoc.GetPool())
+        : SfxItemSet(rDoc.GetPool(), svl::Items<EE_PARA_START, EE_CHAR_END>);
+    // Varied formatting would be lost.
+    if (!oLook)
+        return false;
+    const bool bEmpty = rText.isEmpty();
+    // Outline paragraphs take their level from leading tabs.
+    const OUString aText = eKind == PresObjKind::Outline ? rText.replaceAll("\n", "\n\t") : rText;
+    std::unique_ptr<SdrUndoAction> pUndo = rDoc.GetSdrUndoFactory().CreateUndoObjectSetText(*pObj, 0);
+    rDoc.BegUndo(pUndo->GetComment());
+    rDoc.AddUndo(std::move(pUndo));
+    pPage->SetObjText(pObj, nullptr, eKind, bEmpty ? pPage->GetPresObjText(eKind) : aText);
+    if (!bEmpty && oLook->Count())
+    {
+        SdOutliner* pOutl = rDoc.GetInternalOutliner();
+        pOutl->Clear();
+        pOutl->SetText(*pObj->GetOutlinerParaObject());
+        pOutl->QuickSetAttribs(*oLook, ESelection::All());
+        pObj->SetOutlinerParaObject(pOutl->CreateParaObject());
+        pOutl->Clear();
+    }
+    pObj->SetEmptyPresObj(bEmpty);
+    rDoc.EndUndo();
+    return true;
+}
