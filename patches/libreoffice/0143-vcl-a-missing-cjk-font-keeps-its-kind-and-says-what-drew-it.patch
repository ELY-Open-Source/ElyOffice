--- a/unotools/source/misc/fontdefs.cxx
+++ b/unotools/source/misc/fontdefs.cxx
@@ -301,6 +301,18 @@
     return rNameStr;
 }
 
+bool IsTextCJKFontName(std::u16string_view rName)
+{
+    for (sal_Unicode ch : rName)
+        if (ch == u'\u5B8B' || ch == u'\u660E' || ch == u'\u6977' || ch == u'\u4EFF')
+            return true;
+    const OUString aSearchName = GetEnglishSearchFontName(rName);
+    for (std::u16string_view aKey : { u"song", u"simsun", u"ming", u"mincho", u"kai", u"batang", u"myeongjo" })
+        if (aSearchName.indexOf(aKey) != -1)
+            return true;
+    return false;
+}
