+PhysicalFontFamily* PhysicalFontCollection::ImplFindFontFamilyOfLanguage(const FontSelectPattern& rFSD,
+                                                                         ImplFontAttrs nSearchType,
+                                                                         OUString& rWhy) const
+{
+    LanguageType eLang = rFSD.meLanguage;
+    if (!MsLangId::isCJK(eLang))
+    {
+        const ImplFontAttrs nName = lcl_IsCJKFont(rFSD.GetFamilyName());
+        if (nName & ImplFontAttrs::CJK_KR)
+            eLang = LANGUAGE_KOREAN;
+        else if (nName & ImplFontAttrs::CJK_JP)
+            eLang = LANGUAGE_JAPANESE;
+        else if (nName & ImplFontAttrs::CJK)
+            eLang = MsLangId::resolveSystemLanguageByScriptType(LANGUAGE_SYSTEM,
+                                                                css::i18n::ScriptType::ASIAN);
+        else
+            return nullptr;
+    }
+    const bool bText = (nSearchType & ImplFontAttrs::Serif) || IsTextCJKFontName(rFSD.maTargetName);
+    const LanguageTag aTag(eLang);
+    const OUString aList = utl::DefaultFontConfiguration::get().getDefaultFont(
+        aTag, bText ? DefaultFontType::CJK_TEXT : DefaultFontType::CJK_DISPLAY);
+    for (sal_Int32 nIndex = 0; nIndex != -1;)
+    {
+        std::u16string_view aName = GetNextFontToken(aList, nIndex);
+        if (aName.empty())
+            continue;
+        if (PhysicalFontFamily* pFound = FindFontFamilyByAnyName(aName))
+        {
+            rWhy = aTag.getBcp47()
+                   + (bText ? std::u16string_view(u" text list") : std::u16string_view(u" sans list"));
+            return pFound;
+        }
+    }
+    return nullptr;
+}
