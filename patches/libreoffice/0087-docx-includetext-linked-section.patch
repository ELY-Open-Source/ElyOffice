+bool MSWordExportBase::IsIncludedText(const SwSectionNode& rSectNd) const
+{
+    // .doc and RTF keep the section, as their readers expect.
+    if (GetExportFormat() != ExportFormat::DOCX || rSectNd.GetSection().GetType() != SectionType::FileLink)
+        return false;
+    // Word's field starts and ends in paragraphs.
+    const SwNodes& rNodes = rSectNd.GetNodes();
+    return rNodes[rSectNd.GetIndex() + 1]->IsTextNode() && rNodes[rSectNd.EndOfSectionIndex() - 1]->IsTextNode();
+}
+
+/// The file-linked section `rNode` begins or ends, as INCLUDETEXT.
+static const SwSection* lcl_IncludedAt(const MSWordExportBase& rExport, const SwTextNode& rNode, bool bStart)
+{
+    const SwSectionNode* pSectNd = rNode.FindSectionNode();
+    if (!pSectNd || !rExport.IsIncludedText(*pSectNd))
+        return nullptr;
+    const SwNodeOffset nAt = bStart ? pSectNd->GetIndex() + 1 : pSectNd->EndOfSectionIndex() - 1;
+    return rNode.GetIndex() == nAt ? &pSectNd->GetSection() : nullptr;
+}
+
+/// INCLUDETEXT's code for a file-linked section.
+static OUString lcl_IncludeText(const SwSection& rSection)
+{
+    const OUString& rLink = rSection.GetLinkFileName();
+    const OUString aURL = rLink.getToken(0, sfx2::cTokenSeparator);
+    const OUString aBookmark = rLink.getToken(2, sfx2::cTokenSeparator);
+    OUString aPath;
+    if (osl::FileBase::getSystemPathFromFileURL(aURL, aPath) != osl::FileBase::E_None)
+        aPath = aURL;
+    OUString aCode = FieldString(ww::eINCLUDETEXT) + "\"" + aPath.replaceAll("\\", "\\\\") + "\" ";
+    if (!aBookmark.isEmpty())
+        aCode += "\"" + aBookmark + "\" ";
+    const SfxGrabBagItem* pBag = rSection.GetFormat()->GetAttrSet().GetItemIfSet(RES_FRMATR_GRABBAG, false);
+    if (!pBag)
+        return aCode;
+    if (auto it = pBag->GetGrabBag().find(u"IncludeTextSwitches"_ustr); it != pBag->GetGrabBag().end())
+        aCode += it->second.get<OUString>() + " ";
+    return aCode;
+}
