+/// The section link of an INCLUDETEXT code; empty if none.
+OUString lcl_IncludedLink(const OUString& rCode, const INetURLObject& rBase)
+{
+    const auto & [ sType, aArguments, aSwitches ] = writerfilter::dmapper::splitFieldCommand(rCode);
+    (void)aSwitches;
+    if (!sType.equalsIgnoreAsciiCase("INCLUDETEXT") || aArguments.empty())
+        return OUString();
+    OUString aLink = URIHelper::SmartRel2Abs(rBase, aArguments[0], Link<OUString*, bool>(), false);
+    if (aArguments.size() > 1)
+        aLink += OUStringChar(sfx2::cTokenSeparator) + OUStringChar(sfx2::cTokenSeparator)
+                 + aArguments[1];
+    return aLink;
+}
+
+/// Word's INCLUDETEXT over whole paragraphs becomes a file-linked section.
+void lcl_IncludedSections(SwDoc& rDoc)
+{
+    IDocumentMarkAccess& rMarks = *rDoc.getIDocumentMarkAccess();
+    SfxMedium* pMedium = rDoc.GetDocShell() ? rDoc.GetDocShell()->GetMedium() : nullptr;
+    const INetURLObject aBase(pMedium ? pMedium->GetBaseURL() : OUString());
+    std::vector<std::pair<sw::mark::Fieldmark*, OUString>> aIncluded;
+    for (auto it = rMarks.getFieldmarksBegin(); it != rMarks.getFieldmarksEnd(); ++it)
+    {
+        if ((*it)->GetFieldname() != ODF_UNHANDLED)
+            continue;
+        auto aCode = (*it)->GetParameters()->find(ODF_CODE_PARAM);
+        OUString aText;
+        if (aCode == (*it)->GetParameters()->end() || !(aCode->second >>= aText))
+            continue;
+        if (OUString aLink = lcl_IncludedLink(aText, aBase); !aLink.isEmpty())
+            aIncluded.emplace_back(*it, aLink);
+    }
+    for (const auto & [ pField, aLink ] : aIncluded)
+    {
+        SwTextNode* pFirst = pField->GetMarkStart().GetNode().GetTextNode();
+        SwTextNode* pLast = pField->GetMarkEnd().GetNode().GetTextNode();
+        // A section holds whole paragraphs; text beside stays a field.
+        if (!pFirst || !pLast || pField->GetMarkStart().GetContentIndex() != 0
+            || pField->GetMarkEnd().GetContentIndex() != pLast->GetText().getLength()
+            || !SwDoc::IsInsRegionAvailable(SwPaM(*pFirst, 0, *pLast, pLast->GetText().getLength())))
+        {
+            SAL_INFO("writerfilter", "INCLUDETEXT beside other text stays a field");
+            continue;
+        }
+        IDocumentMarkAccess::DeleteFieldmarkCommand(*pField);
+        rMarks.deleteMark(pField);
+        SwSectionData aSection(SectionType::FileLink, UIName(rDoc.GetUniqueSectionName()));
+        aSection.SetLinkFileName(aLink);
+        aSection.SetProtectFlag(true);
+        // Connected only: the saved text shows until an update.
+        rDoc.InsertSwSection(SwPaM(*pFirst, 0, *pLast, pLast->GetText().getLength()), aSection, nullptr, nullptr,
+                             false);
+    }
+}
