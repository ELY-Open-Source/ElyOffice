+/// A table at a section edge gets a paragraph.
+static void lcl_ParagraphsAtEdges(SwDoc& rDoc, const SwSectionNode& rSectNd)
+{
+    SwNodes& rNodes = rDoc.GetNodes();
+    SwTextFormatColl* pColl = rDoc.getIDocumentStylePoolAccess().GetTextCollFromPool(RES_POOLCOLL_TEXT);
+    // Word starts and ends INCLUDETEXT inside paragraphs.
+    if (!rNodes[rSectNd.GetIndex() + 1]->IsTextNode())
+        rNodes.MakeTextNode(*rNodes[rSectNd.GetIndex() + 1], pColl);
+    if (!rNodes[rSectNd.EndOfSectionIndex() - 1]->IsTextNode())
+        rNodes.MakeTextNode(*rSectNd.EndOfSectionNode(), pColl);
+}
