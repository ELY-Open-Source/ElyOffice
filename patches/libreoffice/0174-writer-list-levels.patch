diff --git a/sw/source/uibase/shells/txtnum.cxx b/sw/source/uibase/shells/txtnum.cxx
--- a/sw/source/uibase/shells/txtnum.cxx
+++ b/sw/source/uibase/shells/txtnum.cxx
@@ -40,6 +40,7 @@
 #include <sfx2/viewfrm.hxx>
 #include <sfx2/bindings.hxx>
 #include <memory>
+#include <o3tl/string_view.hxx>
 
 void SwTextShell::ExecEnterNum(SfxRequest &rReq)
 {
@@ -340,6 +341,40 @@
         }
         break;
 
+    case FN_ELY_LIST_LEVELS:
+        {
+            // Ely: "type|format" a level, ";" between; %1% is level one.
+            const SfxStringItem* pLevels = rReq.GetArg<SfxStringItem>(FN_PARAM_1);
+            if (!pLevels)
+                return;
+            SwWrtShell& rSh = GetShell();
+            const SwNumRule* pCur = rSh.GetNumRuleAtCurrentSelection();
+            SwNumRule aRule(pCur ? pCur->GetName() : rSh.GetUniqueNumRuleName(),
+                            numfunc::GetDefaultPositionAndSpaceMode());
+            if (pCur)
+                aRule = *pCur;
+            const OUString& rSpec = pLevels->GetValue();
+            sal_Int32 nNext = 0;
+            for (sal_uInt16 nLevel = 0; nLevel < MAXLEVEL && nNext >= 0; ++nLevel)
+            {
+                const OUString aLevel = rSpec.getToken(0, ';', nNext);
+                const sal_Int32 nBar = aLevel.indexOf('|');
+                const sal_Int32 nType = nBar > 0 ? o3tl::toInt32(aLevel.subView(0, nBar)) : -1;
+                // A bad level changes nothing: no undo step.
+                const bool bNumber = (nType >= 0 && nType < SVX_NUM_NUMBER_NONE)
+                                     || (nType > SVX_NUM_BITMAP && nType <= SVX_NUM_ARABIC_ZERO5);
+                if (!bNumber || aLevel.indexOf("%", nBar) < 0)
+                    return;
+                SwNumFormat aFormat(aRule.Get(nLevel));
+                aFormat.SetNumberingType(static_cast<SvxNumType>(nType));
+                aFormat.SetListFormat(aLevel.copy(nBar + 1));
+                aRule.Set(nLevel, aFormat);
+            }
+            aRule.SetAutoRule(true);
+            rSh.SetCurNumRule(aRule, pCur == nullptr);
+        }
+        break;
+
     default:
         OSL_ENSURE(false, "wrong Dispatcher");
         return;
