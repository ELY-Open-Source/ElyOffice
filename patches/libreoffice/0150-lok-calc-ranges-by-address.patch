+/// The most cells one range read answers.
+constexpr sal_uInt64 RANGE_CELLS = 1000000;
+
+/// Named range; a bare sheet name spans its used area.
+bool lcl_RangeNamed(ScDocument& rDoc, const OUString& rAddress, ScRange& rRange)
+{
+    SCTAB nTab;
+    if (rDoc.GetTable(rAddress, nTab))
+    {
+        SCCOL nEndCol = 0;
+        SCROW nEndRow = 0;
+        rDoc.GetCellArea(nTab, nEndCol, nEndRow);
+        rRange = ScRange(0, 0, nTab, nEndCol, nEndRow, nTab);
+        return true;
+    }
+    const ScAddress::Details aDetails(rDoc.GetAddressConvention(), 0, 0);
+    const ScRefFlags nFlags = rRange.ParseAny(rAddress, rDoc, aDetails);
+    return (nFlags & ScRefFlags::VALID) && (nFlags & ScRefFlags::TAB_3D)
+           && rRange.aStart.Tab() == rRange.aEnd.Tab() && rDoc.HasTable(rRange.aStart.Tab());
+}
+
+/// Cells row by row; with rows=, columns=: the write target.
+void lcl_RangeAt(tools::JsonWriter& rJson, ScDocument& rDoc, std::string_view rCommand)
+{
+    std::map<OUString, OUString> aMap
+        = SfxLokHelper::parseCommandParameters(OUString::fromUtf8(rCommand));
+    const ScAddress::Details aDetails(rDoc.GetAddressConvention(), 0, 0);
+    rJson.put("commandName", ".uno:RangeAt");
+    ScRange aRange;
+    if (!lcl_RangeNamed(rDoc, aMap[u"address"_ustr], aRange))
+        return rJson.put("error", "address");
+    const sal_uInt64 nCols = aRange.aEnd.Col() - aRange.aStart.Col() + 1;
+    const sal_uInt64 nRows = aRange.aEnd.Row() - aRange.aStart.Row() + 1;
+    if (aMap.contains(u"rows"_ustr))
+    {
+        // One cell grows to the data; a range must match.
+        const sal_Int64 nWantRows = aMap[u"rows"_ustr].toInt64();
+        const sal_Int64 nWantCols = aMap[u"columns"_ustr].toInt64();
+        if (nWantRows < 1 || nWantCols < 1)
+            return rJson.put("error", "shape");
+        if (nCols * nRows > 1 && (sal_uInt64(nWantRows) != nRows || sal_uInt64(nWantCols) != nCols))
+            return rJson.put("error", "shape");
+        if (aRange.aStart.Col() + nWantCols - 1 > rDoc.MaxCol()
+            || aRange.aStart.Row() + nWantRows - 1 > rDoc.MaxRow())
+            return rJson.put("error", "edge");
+        aRange.aEnd.SetCol(aRange.aStart.Col() + nWantCols - 1);
+        aRange.aEnd.SetRow(aRange.aStart.Row() + nWantRows - 1);
+        return rJson.put("address", aRange.Format(rDoc, ScRefFlags::RANGE_ABS_3D, aDetails));
+    }
+    rJson.put("address", aRange.Format(rDoc, ScRefFlags::RANGE_ABS_3D, aDetails));
+    if (nCols * nRows > RANGE_CELLS)
+    {
+        rJson.put("cells", static_cast<sal_Int64>(nCols * nRows));
+        return rJson.put("error", "size");
+    }
+    const SCTAB nTab = aRange.aStart.Tab();
+    auto aRows = rJson.startArray("rows");
+    for (SCROW nRow = aRange.aStart.Row(); nRow <= aRange.aEnd.Row(); ++nRow)
+    {
+        auto aRow = rJson.startAnonArray();
+        for (SCCOL nCol = aRange.aStart.Col(); nCol <= aRange.aEnd.Col(); ++nCol)
+        {
+            auto aCell = rJson.startStruct();
+            const ScAddress aPos(nCol, nRow, nTab);
+            rJson.put("text", rDoc.GetString(aPos));
+            const bool bFormula = rDoc.GetCellType(aPos) == CELLTYPE_FORMULA;
+            rJson.put("input", bFormula ? rDoc.GetFormula(nCol, nRow, nTab)
+                                        : rDoc.GetInputString(nCol, nRow, nTab));
+        }
+    }
+}
