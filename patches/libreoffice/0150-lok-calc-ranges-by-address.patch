+bool ScViewFunc::EnterRowsAt(const ScRange& rRange, const std::vector<std::vector<OUString>>& rRows)
+{
+    ScDocument& rDoc = GetViewData().GetDocument();
+    ScDocShell* pDocSh = GetViewData().GetDocShell();
+    const ScAddress& rStart = rRange.aStart;
+    // Every check runs before the first change.
+    if (size_t(rRange.aEnd.Row() - rStart.Row() + 1) != rRows.size()
+        || size_t(rRange.aEnd.Col() - rStart.Col() + 1) != rRows.front().size()
+        || !rDoc.IsBlockEditable(rStart.Tab(), rStart.Col(), rStart.Row(), rRange.aEnd.Col(), rRange.aEnd.Row()))
+        return false;
+    const bool bUndo = rDoc.IsUndoEnabled();
+    const OUString aUndo = ScResId(STR_UNDO_ENTERDATA);
+    if (bUndo)
+        pDocSh->GetUndoManager()->EnterListAction(aUndo, aUndo, 0, GetViewData().GetViewShell()->GetViewShellId());
+    for (size_t nRow = 0; nRow < rRows.size(); ++nRow)
+        for (size_t nCol = 0; nCol < rRows[nRow].size(); ++nCol)
+            EnterDataAt(ScAddress(SCCOL(rStart.Col() + nCol), SCROW(rStart.Row() + nRow), rStart.Tab()),
+                        rRows[nRow][nCol]);
+    if (bUndo)
+        pDocSh->GetUndoManager()->LeaveListAction();
+    return true;
+}
