+
+/// A JSON array of string rows; false unless rectangular.
+bool lcl_Rows(const OUString& rJson, std::vector<std::vector<OUString>>& rRows)
+{
+    boost::property_tree::ptree aTree;
+    std::stringstream aStream{ std::string(rJson.toUtf8()) };
+    try
+    {
+        boost::property_tree::read_json(aStream, aTree);
+    }
+    catch (const boost::property_tree::json_parser_error&)
+    {
+        return false;
+    }
+    for (const auto& rRow : aTree)
+    {
+        if (!rRow.first.empty() || rRow.second.empty())
+            return false;
+        std::vector<OUString>& rCells = rRows.emplace_back();
+        for (const auto& rCell : rRow.second)
+        {
+            if (!rCell.first.empty() || !rCell.second.empty())
+                return false;
+            rCells.push_back(OUString::fromUtf8(rCell.second.data()));
+        }
+        if (rCells.size() != rRows.front().size())
+            return false;
+    }
+    return !rRows.empty();
+}
