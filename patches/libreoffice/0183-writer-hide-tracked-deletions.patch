+void SwRootFrame::ShowRedlines(bool const bShow)
+{
+    bool const bMark(bShow && mbHideDeletions);
+    bool const bHide(!bShow || bMark);
+    if (bHide == mbHideRedlines && bMark != mbMarkInserts)
+    {   // same text, only the marks change
+        mbMarkInserts = bMark;
+        InvalidateAllContent(SwInvalidateFlags::Size);
+        return;
+    }
+    mbMarkInserts = bMark;
+    SetHideRedlines(bHide);
+}
