+/// The farthest index from nFrom toward nTo where bTaken holds.
+template <typename T, typename F> T lcl_Farthest(T nFrom, T nTo, F bTaken)
+{
+    const sal_Int64 nStep = nTo < nFrom ? -1 : 1;
+    sal_Int64 nLow = 0, nHigh = std::abs(sal_Int64(nTo) - nFrom);
+    while (nLow < nHigh)
+    {
+        const sal_Int64 nMid = (nLow + nHigh + 1) / 2;
+        if (bTaken(T(nFrom + nStep * nMid)))
+            nLow = nMid;
+        else
+            nHigh = nMid - 1;
+    }
+    return T(nFrom + nStep * nLow);
+}
