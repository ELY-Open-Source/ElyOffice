+namespace {
+
+/// Whether a cell or name of rDoc uses INDIRECT.
+bool lcl_HasIndirect(ScDocument& rDoc)
+{
+    auto bIndirect = [](const ScRangeName* pNames) {
+        return pNames && std::any_of(pNames->begin(), pNames->end(), [](const auto& rEntry) {
+            return rEntry.second->GetCode()->HasOpCode(ocIndirect);
+        });
+    };
+    if (bIndirect(rDoc.GetRangeName()))
+        return true;
+    for (SCTAB nTab = 0; nTab < rDoc.GetTableCount(); ++nTab)
+        if (bIndirect(rDoc.GetRangeName(nTab)))
+            return true;
+    ScCellIterator aIter(rDoc, ScRange(0, 0, 0, rDoc.MaxCol(), rDoc.MaxRow(), rDoc.GetTableCount() - 1));
+    for (bool bCell = aIter.first(); bCell; bCell = aIter.next())
+        if (aIter.getType() == CELLTYPE_FORMULA && aIter.getFormulaCell()->GetCode()->HasOpCode(ocIndirect))
+            return true;
+    return false;
+}
