+/// Ely: `rValue`'s cell formats, every script alike.
+void lcl_ElyPattern(const ScDocument& rDoc, const OUString& rValue, ScPatternAttr& rPattern)
+{
+    const auto aOn = [&](std::u16string_view rKey) { return lcl_ElyField(rValue, rKey); };
+    if (const auto o = aOn(u"bold"))
+    {
+        const FontWeight eWeight = *o == u"1" ? WEIGHT_BOLD : WEIGHT_NORMAL;
+        for (const auto nWhich : { ATTR_FONT_WEIGHT, ATTR_CJK_FONT_WEIGHT, ATTR_CTL_FONT_WEIGHT })
+            rPattern.ItemSetPut(SvxWeightItem(eWeight, nWhich));
+    }
+    if (const auto o = aOn(u"italic"))
+    {
+        const FontItalic eItalic = *o == u"1" ? ITALIC_NORMAL : ITALIC_NONE;
+        for (const auto nWhich : { ATTR_FONT_POSTURE, ATTR_CJK_FONT_POSTURE, ATTR_CTL_FONT_POSTURE })
+            rPattern.ItemSetPut(SvxPostureItem(eItalic, nWhich));
+    }
+    if (const auto o = aOn(u"underline"))
+        rPattern.ItemSetPut(SvxUnderlineItem(*o == u"1" ? LINESTYLE_SINGLE : LINESTYLE_NONE,
+                                             ATTR_FONT_UNDERLINE));
+    if (const auto o = aOn(u"wrap"))
+        rPattern.ItemSetPut(ScLineBreakCell(*o == u"1"));
+    if (const auto o = aOn(u"font"))
+        for (const auto nWhich : { ATTR_FONT, ATTR_CJK_FONT, ATTR_CTL_FONT })
+            rPattern.ItemSetPut(SvxFontItem(FAMILY_DONTKNOW, *o, OUString(), PITCH_DONTKNOW,
+                                            RTL_TEXTENCODING_DONTKNOW, nWhich));
+    if (const auto o = aOn(u"size"))
+        for (const auto nWhich : { ATTR_FONT_HEIGHT, ATTR_CJK_FONT_HEIGHT, ATTR_CTL_FONT_HEIGHT })
+            rPattern.ItemSetPut(SvxFontHeightItem(o->toUInt32(), 100, nWhich));
+    if (const auto o = aOn(u"color"))
+        rPattern.ItemSetPut(SvxColorItem(
+            *o == u"none" ? COL_AUTO : Color(ColorTransparency, o->toUInt32()), ATTR_FONT_COLOR));
+    if (const auto o = aOn(u"background"))
+        rPattern.ItemSetPut(SvxBrushItem(
+            *o == u"none" ? COL_TRANSPARENT : Color(ColorTransparency, o->toUInt32()), ATTR_BACKGROUND));
+    if (const auto o = aOn(u"number"))
+    {
+        rPattern.ItemSetPut(SfxUInt32Item(ATTR_VALUE_FORMAT, *lcl_ElyNumberKey(rDoc, *o)));
+        rPattern.ItemSetPut(SvxLanguageItem(LANGUAGE_ENGLISH_US, ATTR_LANGUAGE_FORMAT));
+    }
+    if (const auto o = aOn(u"align"))
+    {
+        SvxCellHorJustify eHor = SvxCellHorJustify::Standard;
+        if (*o == u"left") eHor = SvxCellHorJustify::Left;
+        else if (*o == u"center") eHor = SvxCellHorJustify::Center;
+        else if (*o == u"right") eHor = SvxCellHorJustify::Right;
+        else if (*o == u"justify") eHor = SvxCellHorJustify::Block;
+        rPattern.ItemSetPut(SvxHorJustifyItem(eHor, ATTR_HOR_JUSTIFY));
+    }
+    if (const auto o = aOn(u"valign"))
+    {
+        SvxCellVerJustify eVer = SvxCellVerJustify::Standard;
+        if (*o == u"top") eVer = SvxCellVerJustify::Top;
+        else if (*o == u"middle") eVer = SvxCellVerJustify::Center;
+        else if (*o == u"bottom") eVer = SvxCellVerJustify::Bottom;
+        rPattern.ItemSetPut(SvxVerJustifyItem(eVer, ATTR_VER_JUSTIFY));
+    }
+}
