+/// Ely: one edge; null for "none", else "style:width:color" in twips.
+std::unique_ptr<editeng::SvxBorderLine> lcl_ElyLine(std::u16string_view rEdge)
+{
+    if (rEdge == u"none")
+        return {};
+    sal_Int32 nIndex = 0;
+    const sal_Int32 nStyle = o3tl::toInt32(o3tl::getToken(rEdge, 0, ':', nIndex));
+    const sal_Int32 nWidth = o3tl::toInt32(o3tl::getToken(rEdge, 0, ':', nIndex));
+    const Color aColor(ColorTransparency, o3tl::toUInt32(o3tl::getToken(rEdge, 0, ':', nIndex)));
+    return std::make_unique<editeng::SvxBorderLine>(&aColor, nWidth,
+                                                    static_cast<SvxBorderLineStyle>(nStyle));
+}
