+/// Ely: formats and borders on `rRange` as one undo step.
+bool lcl_ElyFormat(ScDocShell& rDocShell, const ScRange& rRange, const OUString& rValue)
+{
+    ScDocument& rDoc = rDocShell.GetDocument();
+    ScPatternAttr aPattern(rDoc.getCellAttributeHelper());
+    lcl_ElyPattern(rDoc, rValue, aPattern);
+    // Edges not named keep their lines.
+    SvxBoxItem aOuter(ATTR_BORDER);
+    SvxBoxInfoItem aInner(ATTR_BORDER_INNER);
+    aInner.SetTable(true);
+    aInner.SetValid(SvxBoxInfoItemValidFlags::DISTANCE, false);
+    bool bLines = false;
+    const std::pair<std::u16string_view, SvxBoxItemLine> aOuterEdges[]
+        = { { u"border-left", SvxBoxItemLine::LEFT }, { u"border-top", SvxBoxItemLine::TOP },
+            { u"border-right", SvxBoxItemLine::RIGHT }, { u"border-bottom", SvxBoxItemLine::BOTTOM } };
+    const SvxBoxInfoItemValidFlags aOuterFlags[]
+        = { SvxBoxInfoItemValidFlags::LEFT, SvxBoxInfoItemValidFlags::TOP,
+            SvxBoxInfoItemValidFlags::RIGHT, SvxBoxInfoItemValidFlags::BOTTOM };
+    for (size_t i = 0; i < std::size(aOuterEdges); ++i)
+    {
+        const auto o = lcl_ElyField(rValue, aOuterEdges[i].first);
+        aInner.SetValid(aOuterFlags[i], o.has_value());
+        if (!o)
+            continue;
+        bLines = true;
+        aOuter.SetLine(lcl_ElyLine(*o).get(), aOuterEdges[i].second);
+    }
+    const std::pair<std::u16string_view, SvxBoxInfoItemLine> aInnerEdges[]
+        = { { u"border-inner-h", SvxBoxInfoItemLine::HORI },
+            { u"border-inner-v", SvxBoxInfoItemLine::VERT } };
+    const SvxBoxInfoItemValidFlags aInnerFlags[]
+        = { SvxBoxInfoItemValidFlags::HORI, SvxBoxInfoItemValidFlags::VERT };
+    for (size_t i = 0; i < std::size(aInnerEdges); ++i)
+    {
+        const auto o = lcl_ElyField(rValue, aInnerEdges[i].first);
+        aInner.SetValid(aInnerFlags[i], o.has_value());
+        if (!o)
+            continue;
+        bLines = true;
+        aInner.SetLine(lcl_ElyLine(*o).get(), aInnerEdges[i].second);
+    }
+    ScMarkData aMark(rDoc.GetSheetLimits());
+    aMark.SelectTable(rRange.aStart.Tab(), true);
+    aMark.SetMarkArea(rRange);
+    ScDocShellModificator aModificator(rDocShell);
+    if (rDoc.IsUndoEnabled())
+    {
+        ScDocumentUniquePtr pUndoDoc(new ScDocument(SCDOCMODE_UNDO));
+        pUndoDoc->InitUndo(rDoc, rRange.aStart.Tab(), rRange.aStart.Tab());
+        rDoc.CopyToDocument(rRange, InsertDeleteFlags::ATTRIB, false, *pUndoDoc, &aMark);
+        rDocShell.GetUndoManager()->AddUndoAction(std::make_unique<ScUndoSelectionAttr>(
+            rDocShell, aMark, rRange.aStart.Col(), rRange.aStart.Row(), rRange.aStart.Tab(),
+            rRange.aEnd.Col(), rRange.aEnd.Row(), rRange.aEnd.Tab(), std::move(pUndoDoc), false,
+            &aPattern, bLines ? &aOuter : nullptr, bLines ? &aInner : nullptr, &rRange));
+    }
+    sal_uInt16 nExt = SC_PF_TESTMERGE;
+    rDocShell.UpdatePaintExt(nExt, rRange);
+    if (bLines)
+        rDoc.ApplySelectionFrame(aMark, aOuter, &aInner);
+    aMark.MarkToMulti();
+    rDoc.ApplySelectionPattern(aPattern, aMark);
+    rDocShell.UpdatePaintExt(nExt, rRange);
+    // Wrap and size may change row heights.
+    if (rDocShell.AdjustRowHeight(rRange.aStart.Row(), rRange.aEnd.Row(), rRange.aStart.Tab()))
+        lcl_ElyResized(rDocShell, rRange.aStart.Tab(), false, rRange.aStart.Row());
+    rDocShell.PostPaint(rRange, PaintPartFlags::Grid, nExt);
+    aModificator.SetDocumentModified();
+    return true;
+}
