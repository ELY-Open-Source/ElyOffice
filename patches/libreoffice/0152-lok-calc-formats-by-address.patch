+/// Ely: the value `rKey` has in `rValue`'s key=value lines.
+std::optional<OUString> lcl_ElyField(const OUString& rValue, std::u16string_view rKey)
+{
+    sal_Int32 nIndex = 0;
+    while (nIndex >= 0)
+    {
+        const OUString aLine = rValue.getToken(0, '\n', nIndex);
+        const sal_Int32 nEq = aLine.indexOf('=');
+        if (nEq > 0 && aLine.subView(0, nEq) == rKey)
+            return aLine.copy(nEq + 1);
+    }
+    return {};
+}
+
+/// Ely: the en-US number format for `rCode`, added if new.
+std::optional<sal_uInt32> lcl_ElyNumberKey(const ScDocument& rDoc, const OUString& rCode)
+{
+    SvNumberFormatter* pFormatter = rDoc.GetFormatTable();
+    sal_uInt32 nKey = pFormatter->GetEntryKey(rCode, LANGUAGE_ENGLISH_US);
+    if (nKey != NUMBERFORMAT_ENTRY_NOT_FOUND)
+        return nKey;
+    OUString aCode = rCode;
+    sal_Int32 nCheck = 0;
+    SvNumFormatType nType = SvNumFormatType::ALL;
+    // False also means already there; nCheck tells.
+    pFormatter->PutEntry(aCode, nCheck, nType, nKey, LANGUAGE_ENGLISH_US);
+    if (nCheck != 0 || nKey == NUMBERFORMAT_ENTRY_NOT_FOUND)
+        return {};
+    return nKey;
+}
