+/// Refuses: disapproves, else aborts.
+void selectRefused(uno::Sequence<uno::Reference<task::XInteractionContinuation>> const &rContinuations)
+{
+    for (auto const & c : rContinuations)
+    {
+        if (uno::Reference<task::XInteractionDisapprove> xDisapprove(c, uno::UNO_QUERY); xDisapprove.is())
+            return xDisapprove->select();
+    }
+    for (auto const & c : rContinuations)
+    {
+        if (uno::Reference<task::XInteractionAbort> xAbort(c, uno::UNO_QUERY); xAbort.is())
+            return xAbort->select();
+    }
+}
