+
+// A refusal ElyTable words by its code.
+struct Refusal
+{
+    const char* code;
+};
+
+inline void require(bool b, const char* code)
+{
+    if (!b)
+        throw Refusal{ code };
+}
+
+// Why the last batch failed, kept until ElyTable reads it.
+struct Reason
+{
+    std::string code;
+    OUString message;
+};
+
+inline Reason& lastRefusal()
+{
+    static Reason aReason;
+    return aReason;
+}
+
+// Hands over the last reason once.
+inline void refusal(tools::JsonWriter& rJson)
+{
+    Reason& rReason = lastRefusal();
+    rJson.put("refused", rReason.code);
+    rJson.put("message", rReason.message);
+    rReason = Reason();
+}
+
+// ElyTable's limit for the selection and the batch.
+constexpr sal_Int64 nBudget = 4 * 1024 * 1024;
+
+inline Reference<css::table::XCellRange> selection(const Reference<css::frame::XModel>& xModel)
+{
+    Reference<css::view::XSelectionSupplier> xSelection(xModel->getCurrentController(), UNO_QUERY_THROW);
+    // Shapes and several ranges are not one block.
+    Reference<css::table::XCellRange> xRange(xSelection->getSelection(), UNO_QUERY);
+    require(xRange.is(), "range");
+    return xRange;
+}
+
+inline css::table::CellRangeAddress address(const Reference<css::table::XCellRange>& xRange)
+{
+    return Reference<css::sheet::XCellRangeAddressable>(xRange, UNO_QUERY_THROW)->getRangeAddress();
+}
+
+inline OUString rangeName(const css::table::CellRangeAddress& a)
+{
+    return OUString::number(a.Sheet) + ":" + OUString::number(a.StartColumn) + ":"
+        + OUString::number(a.StartRow) + ":" + OUString::number(a.EndColumn) + ":"
+        + OUString::number(a.EndRow);
+}
+
+inline bool logical(const Reference<css::frame::XModel>& xModel,
+                    const Reference<css::table::XCell>& xCell)
+{
+    Reference<css::beans::XPropertySet> xProps(xCell, UNO_QUERY_THROW);
+    sal_Int32 nFormat = 0;
+    xProps->getPropertyValue(u"NumberFormat"_ustr) >>= nFormat;
+    Reference<css::util::XNumberFormatsSupplier> xFormats(xModel, UNO_QUERY_THROW);
+    sal_Int16 nType = 0;
+    xFormats->getNumberFormats()->getByKey(nFormat)->getPropertyValue(u"Type"_ustr) >>= nType;
+    return nType & css::util::NumberFormat::LOGICAL;
+}
+
+inline std::string decimal(double value)
+{
+    require(std::isfinite(value), "unreadable");
+    char buffer[64];
+    const auto result = std::to_chars(buffer, buffer + sizeof(buffer), value,
+        std::chars_format::general, std::numeric_limits<double>::max_digits10);
+    require(result.ec == std::errc{}, "unreadable");
+    return std::string(buffer, result.ptr);
+}
+
+// Subnormals included; stream extraction rejects them on libc++.
+inline double number(const std::string& rText)
+{
+    rtl_math_ConversionStatus eStatus = rtl_math_ConversionStatus_Ok;
+    sal_Int32 nEnd = 0;
+    const double f = rtl::math::stringToDouble(rText, '.', 0, &eStatus, &nEnd);
+    require(!rText.empty() && eStatus == rtl_math_ConversionStatus_Ok
+        && nEnd == sal_Int32(rText.size()) && std::isfinite(f), "invalid");
+    return f;
+}
+
+// One cell's fields, as both passes write them.
+inline void cell(tools::JsonWriter& rJson, const Reference<css::frame::XModel>& xModel,
+                 const Reference<css::table::XCell>& xCell)
+{
+    auto eType = xCell->getType();
+    if (eType == css::table::CellContentType_FORMULA)
+    {
+        rJson.put("formula", xCell->getFormula());
+        // Formula results remain separate from their source.
+        sal_Int32 nResult = 0;
+        Reference<css::beans::XPropertySet>(xCell, UNO_QUERY_THROW)
+            ->getPropertyValue(u"FormulaResultType2"_ustr) >>= nResult;
+        eType = nResult == 1 ? css::table::CellContentType_VALUE
+                            : css::table::CellContentType_TEXT;
+    }
+    if (eType == css::table::CellContentType_EMPTY)
+    {
+        rJson.put("kind", "empty");
+        rJson.put("value", "");
+    }
+    else if (eType == css::table::CellContentType_VALUE)
+    {
+        const bool bLogical = logical(xModel, xCell);
+        rJson.put("kind", bLogical ? "boolean" : "number");
+        if (bLogical)
+            rJson.put("value", xCell->getValue() != 0);
+        else
+            rJson.put("value", decimal(xCell->getValue()));
+    }
+    else
+    {
+        rJson.put("kind", "text");
+        rJson.put("value", Reference<css::text::XTextRange>(xCell, UNO_QUERY_THROW)->getString());
+    }
+}
+
+inline void snapshot(tools::JsonWriter& rJson, const Reference<css::frame::XModel>& xModel)
+{
+    const auto xRange = selection(xModel);
+    const auto a = address(xRange);
+    const sal_Int32 nRows = a.EndRow - a.StartRow + 1;
+    const sal_Int32 nColumns = a.EndColumn - a.StartColumn + 1;
+    require(nRows > 0 && nColumns > 0 && sal_Int64(nRows) * nColumns <= 10000, "cells");
+    // The reply's exact bytes, counted before the copy.
+    tools::JsonWriter aFrame;
+    aFrame.put("range", rangeName(a));
+    aFrame.put("rows", nRows);
+    aFrame.put("columns", nColumns);
+    {
+        auto aNone = aFrame.startArray("cells");
+    }
+    sal_Int64 nBytes = aFrame.finishAndGetAsOString().getLength();
+    for (sal_Int32 r = 0; r < nRows; ++r)
+        for (sal_Int32 c = 0; c < nColumns; ++c)
+        {
+            tools::JsonWriter aOne;
+            cell(aOne, xModel, xRange->getCellByPosition(c, r));
+            // Each cell after the first follows ", ".
+            nBytes += aOne.finishAndGetAsOString().getLength() + (r || c ? 2 : 0);
+            require(nBytes <= nBudget, "too_big");
+        }
+    rJson.put("range", rangeName(a));
+    rJson.put("rows", nRows);
+    rJson.put("columns", nColumns);
+    auto aCells = rJson.startArray("cells");
+    for (sal_Int32 r = 0; r < nRows; ++r)
+        for (sal_Int32 c = 0; c < nColumns; ++c)
+        {
+            auto aCell = rJson.startStruct();
+            cell(rJson, xModel, xRange->getCellByPosition(c, r));
+        }
+}
+
+inline void canonical(ptree& rTree)
+{
+    for (auto& entry : rTree)
+        canonical(entry.second);
+    if (!rTree.empty() && !rTree.front().first.empty())
+        rTree.sort();
+}
+
+inline ptree parse(const std::string& rText)
+{
+    std::istringstream aStream(rText);
+    ptree aTree;
+    boost::property_tree::read_json(aStream, aTree);
+    canonical(aTree);
+    return aTree;
+}
+
+struct Write
+{
+    sal_Int32 nIndex;
+    std::string aKind;
+    std::string aValue;
+};
+
+struct Batch
+{
+    std::vector<Write> aWrites;
+    std::string aBold;
+    bool bAutofit = false;
+};
+
+// Every check runs before the first change.
+inline Batch validated(const ptree& rTree, sal_Int32 nCells)
+{
+    Batch aBatch;
+    std::set<sal_Int32> aIndices;
+    for (const auto& rEntry : rTree.get_child("writes"))
+    {
+        const auto& w = rEntry.second;
+        Write aWrite{ w.get<sal_Int32>("index"), w.get<std::string>("kind"),
+                      w.get<std::string>("value") };
+        const auto& k = aWrite.aKind;
+        const auto& v = aWrite.aValue;
+        require(aWrite.nIndex >= 0 && aWrite.nIndex < nCells
+            && aIndices.insert(aWrite.nIndex).second, "invalid");
+        require(k == "text" || k == "number" || k == "boolean" || k == "empty", "invalid");
+        // Calc holds no empty text; an empty write clears.
+        require(k != "text" || (!v.empty() && v.size() <= 32767
+            && v.find('\0') == std::string::npos), "invalid");
+        if (k == "number")
+            number(v);
+        require(k != "boolean" || v == "true" || v == "false", "invalid");
+        require(k != "empty" || v == "null", "invalid");
+        aBatch.aWrites.push_back(std::move(aWrite));
+    }
+    aBatch.aBold = rTree.get<std::string>("bold");
+    require(aBatch.aBold == "null" || aBatch.aBold == "true" || aBatch.aBold == "false", "invalid");
+    aBatch.bAutofit = rTree.get<bool>("autofit");
+    return aBatch;
+}
+
+inline void apply(const Reference<css::frame::XModel>& xModel, const ScDocument& rDoc,
+                  const OUString& rBatch, SfxUndoManager& rUndo, ViewShellId nView)
+{
+    require(rBatch.getLength() <= nBudget, "batch_too_big");
+    tools::JsonWriter aNow;
+    // A selection R did not read is a changed one.
+    try
+    {
+        snapshot(aNow, xModel);
+    }
+    catch (const Refusal&)
+    {
+        throw Refusal{ "changed" };
+    }
+    const auto xRange = selection(xModel);
+    const auto a = address(xRange);
+    const sal_Int32 nRows = a.EndRow - a.StartRow + 1;
+    const sal_Int32 nColumns = a.EndColumn - a.StartColumn + 1;
+    Batch aBatch;
+    try
+    {
+        const auto aTree = parse(rBatch.toUtf8().getStr());
+        require(parse(aNow.finishAndGetAsOString().getStr()) == aTree.get_child("snapshot"), "changed");
+        aBatch = validated(aTree, nRows * nColumns);
+    }
+    catch (const boost::property_tree::ptree_error&)
+    {
+        throw Refusal{ "invalid" };
+    }
+    Reference<css::sheet::XSheetCellRange> xSheetRange(xRange, UNO_QUERY_THROW);
+    auto xSheet = xSheetRange->getSpreadsheet();
+    // Format changes need only an unprotected sheet.
+    if (aBatch.aBold != "null" || aBatch.bAutofit)
+        require(!Reference<css::util::XProtectable>(xSheet, UNO_QUERY_THROW)->isProtected(), "protected");
+    // Reject merged ranges, including a merge crossing the boundary.
+    auto xCursor = xSheet->createCursorByRange(xSheetRange);
+    xCursor->collapseToMergedArea();
+    require(rangeName(address(Reference<css::table::XCellRange>(xCursor, UNO_QUERY_THROW))) == rangeName(a), "merged");
+    for (sal_Int32 r = 0; r < nRows; ++r)
+        for (sal_Int32 c = 0; c < nColumns; ++c)
+            require(!Reference<css::util::XMergeable>(xRange->getCellRangeByPosition(c,r,c,r), UNO_QUERY_THROW)->getIsMerged(), "merged");
+    for (const auto& w : aBatch.aWrites)
+        require(xRange->getCellByPosition(w.nIndex % nColumns, w.nIndex / nColumns)->getType()
+            != css::table::CellContentType_FORMULA, "invalid");
+    require(rUndo.IsUndoEnabled() && rUndo.GetMaxUndoActionCount() > 0, "undo_off");
+    require(!rUndo.IsInListAction(), "busy");
+    static std::atomic<sal_uInt64> nRun{0};
+    const OUString aTitle = u"R macro (experimental) #"_ustr + OUString::number(++nRun);
+    xModel->lockControllers();
+    comphelper::ScopeGuard aUnlock([&] { xModel->unlockControllers(); });
+    rUndo.EnterListAction(aTitle, aTitle, 0, nView);
+    bool bLeft = false;
+    try
+    {
+        for (const auto& w : aBatch.aWrites)
+        {
+            const sal_Int32 c = w.nIndex % nColumns;
+            const sal_Int32 r = w.nIndex / nColumns;
+            const auto xCell = xRange->getCellByPosition(c, r);
+            // Calc's own rule for typing into this cell.
+            const SCCOL nCol = SCCOL(a.StartColumn + c);
+            const SCROW nRow = SCROW(a.StartRow + r);
+            require(rDoc.IsBlockEditable(SCTAB(a.Sheet), nCol, nRow, nCol, nRow), "locked");
+            if (w.aKind == "text")
+                Reference<css::text::XTextRange>(xCell, UNO_QUERY_THROW)->setString(OUString::fromUtf8(w.aValue));
+            else if (w.aKind == "empty")
+                Reference<css::sheet::XSheetOperation>(xRange->getCellRangeByPosition(c, r, c, r), UNO_QUERY_THROW)
+                    ->clearContents(css::sheet::CellFlags::VALUE | css::sheet::CellFlags::DATETIME | css::sheet::CellFlags::STRING | css::sheet::CellFlags::FORMULA);
+            else
+            {
+                if (w.aKind == "boolean" || logical(xModel, xCell))
+                {
+                    Reference<css::util::XNumberFormatsSupplier> xFormats(xModel, UNO_QUERY_THROW);
+                    Reference<css::util::XNumberFormatTypes> xTypes(xFormats->getNumberFormats(), UNO_QUERY_THROW);
+                    css::lang::Locale aLocale;
+                    aLocale.Language = "en";
+                    aLocale.Country = "US";
+                    const sal_Int32 nFormat = xTypes->getStandardFormat(w.aKind == "boolean" ? css::util::NumberFormat::LOGICAL : css::util::NumberFormat::NUMBER, aLocale);
+                    Reference<css::beans::XPropertySet>(xCell, UNO_QUERY_THROW)->setPropertyValue(u"NumberFormat"_ustr, css::uno::Any(nFormat));
+                }
+                xCell->setValue(w.aKind == "boolean" ? (w.aValue == "true" ? 1 : 0) : number(w.aValue));
+            }
+        }
+        if (aBatch.aBold != "null")
+        {
+            const css::uno::Any aWeight(aBatch.aBold == "true" ? css::awt::FontWeight::BOLD : css::awt::FontWeight::NORMAL);
+            Reference<css::beans::XPropertySet> xHeader(xRange->getCellRangeByPosition(0, 0, nColumns - 1, 0), UNO_QUERY_THROW);
+            // Western, Asian and complex scripts weigh apart.
+            for (const auto& rName : { u"CharWeight"_ustr, u"CharWeightAsian"_ustr, u"CharWeightComplex"_ustr })
+                xHeader->setPropertyValue(rName, aWeight);
+        }
+        if (aBatch.bAutofit)
+        {
+            Reference<css::table::XColumnRowRange> xColumns(xRange, UNO_QUERY_THROW);
+            for (sal_Int32 c = 0; c < nColumns; ++c)
+                Reference<css::beans::XPropertySet>(xColumns->getColumns()->getByIndex(c), UNO_QUERY_THROW)
+                    ->setPropertyValue(u"OptimalWidth"_ustr, css::uno::Any(true));
+        }
+        rUndo.LeaveListAction();
+        bLeft = true;
+    }
+    catch (...)
+    {
+        if (!bLeft)
+            rUndo.LeaveListAction();
+        // Undone, the partial list must not wait in Redo.
+        if (rUndo.GetUndoActionCount() && rUndo.GetUndoActionComment() == aTitle)
+        {
+            bool bUndone = false;
+            try
+            {
+                bUndone = rUndo.Undo();
+            }
+            catch (...)
+            {
+                SAL_WARN("sc.ui", "R macro rollback threw");
+            }
+            rUndo.ClearRedo();
+            // Writes left in place: never report "nothing changed".
+            require(bUndone, "rollback");
+        }
+        throw;
+    }
+}
+}
