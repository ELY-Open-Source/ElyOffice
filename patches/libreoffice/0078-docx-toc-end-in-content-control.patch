+/// The cursor's paragraph, if it is a TOC's last.
+static SwTextNode* lcl_TOCEndParagraph(const uno::Reference<text::XTextRange>& xPosition)
+{
+    auto pCursor = dynamic_cast<SwXTextCursor*>(xPosition.get());
+    SwPaM* pPaM = pCursor ? pCursor->GetPaM() : nullptr;
+    SwTextNode* pParagraph = pPaM ? pPaM->GetPointNode().GetTextNode() : nullptr;
+    if (!pParagraph)
+        return nullptr;
+    const SwSectionNode* pTOC = pParagraph->FindSectionNode();
+    if (!pTOC || pTOC->GetSection().GetType() != SectionType::ToxContent
+        || pTOC->EndOfSectionIndex() != pParagraph->GetIndex() + 1)
+        return nullptr;
+    return pParagraph;
+}
+
+static bool lcl_HoldsContent(const SwTextNode& rParagraph)
+{
+    return rParagraph.Len() || !rParagraph.GetAnchoredFlys().empty();
+}
+
+/// Moves a section's last paragraph, from nAt on, after it.
+static void lcl_MoveOutOfSection(SwTextNode& rParagraph, sal_Int32 nAt)
+{
+    // The node keeps the second half
+    if (nAt && !rParagraph.GetDoc().getIDocumentContentOperations().SplitNode(SwPosition(rParagraph, nAt), false))
+        throw uno::RuntimeException(u"TOC tail paragraph did not split"_ustr);
+    SwNodes& rNodes = rParagraph.GetNodes();
+    SwNodeIndex aAfter(*rParagraph.EndOfSectionNode(), 1);
+    // Keeps the node, so marks and ranges in it survive
+    if (!rNodes.MoveNodes(SwNodeRange(rParagraph, SwNodeOffset(0), rParagraph, SwNodeOffset(1)),
+                          rNodes, aAfter.GetNode()))
+        throw uno::RuntimeException(u"TOC tail paragraph did not move"_ustr);
+}
