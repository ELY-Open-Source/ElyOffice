+/// Word's link target as a file URL; Word writes backslashes.
+static OUString lcl_LinkURL(const OUString& rTarget, const OUString& rBaseUrl)
+{
+    OUString aURL;
+    const bool bSystem = (rTarget.getLength() > 2 && rTarget[1] == ':') || rTarget.startsWith("\\\\");
+    if (bSystem && osl::FileBase::getFileURLFromSystemPath(rTarget, aURL) == osl::FileBase::E_None)
+        return aURL;
+    return URIHelper::SmartRel2Abs(INetURLObject(rBaseUrl), rTarget.replace('\\', '/'),
+                                   Link<OUString*, bool>(), false);
+}
+
+/// Word's linked object, read only on update.
+static uno::Reference<embed::XEmbeddedObject> lcl_LinkedObject(const OLEHandler& rOLE,
+                                                               const OUString& rBaseUrl)
+{
+    const OUString aURL = lcl_LinkURL(rOLE.getLinkTarget(), rBaseUrl);
+    // The filter named: a missing file still links.
+    const uno::Sequence<beans::PropertyValue> aMedium{
+        comphelper::makePropertyValue(u"URL"_ustr, aURL),
+        comphelper::makePropertyValue(u"FilterName"_ustr, rOLE.getLinkFilter()),
+        comphelper::makePropertyValue(u"Referer"_ustr, rBaseUrl)
+    };
+    uno::Reference<embed::XEmbeddedObjectCreator> xFactory
+        = embed::OOoEmbeddedObjectFactory::create(comphelper::getProcessComponentContext());
+    return uno::Reference<embed::XEmbeddedObject>(
+        xFactory->createInstanceLink(comphelper::OStorageHelper::GetTemporaryStorage(),
+                                     u"DummyName"_ustr, aMedium, {}),
+        uno::UNO_QUERY_THROW);
+}
