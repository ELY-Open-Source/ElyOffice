+bool OLEHandler::isLink() const
+{
+    return m_sType == "Link" && !m_sLinkTarget.isEmpty() && !getLinkFilter().isEmpty();
+}
+
+bool OLEHandler::isPicturedLink() const
+{
+    return m_sType == "Link" && !isLink();
+}
+
+OUString OLEHandler::getLinkFilter() const
+{
+    static const std::unordered_map<OUString, OUString> aFilters{
+        { u"Excel.Sheet.12"_ustr, u"Calc MS Excel 2007 XML"_ustr },
+        { u"Excel.Sheet.8"_ustr, u"MS Excel 97"_ustr },
+        { u"Word.Document.12"_ustr, u"MS Word 2007 XML"_ustr },
+        { u"Word.Document.8"_ustr, u"MS Word 97"_ustr },
+        { u"PowerPoint.Show.12"_ustr, u"Impress MS PowerPoint 2007 XML"_ustr },
+        { u"PowerPoint.Show.8"_ustr, u"MS PowerPoint 97"_ustr },
+        { u"Excel.SheetMacroEnabled.12"_ustr, u"Calc MS Excel 2007 VBA XML"_ustr },
+        { u"Excel.SheetBinaryMacroEnabled.12"_ustr, u"Calc MS Excel 2007 Binary"_ustr },
+        { u"Word.DocumentMacroEnabled.12"_ustr, u"MS Word 2007 XML VBA"_ustr },
+        { u"PowerPoint.ShowMacroEnabled.12"_ustr, u"Impress MS PowerPoint 2007 XML VBA"_ustr },
+    };
+    auto it = aFilters.find(m_sProgId);
+    if (it != aFilters.end())
+        return it->second;
+    SAL_WARN_IF(m_sType == "Link", "writerfilter", "linked " << m_sProgId << " stays a picture");
+    return OUString();
+}
+
+void OLEHandler::keepLink(const uno::Reference<text::XTextDocument>& xTextDocument,
+                          const uno::Reference<text::XTextContent>& xOLE)
+{
+    uno::Reference<beans::XPropertySet> xPropertySet(xOLE, uno::UNO_QUERY_THROW);
+    ::oox::ole::SaveInteropProperties(xTextDocument,
+        xPropertySet->getPropertyValue(u"StreamName"_ustr).get<OUString>(), nullptr, m_sProgId);
+}
