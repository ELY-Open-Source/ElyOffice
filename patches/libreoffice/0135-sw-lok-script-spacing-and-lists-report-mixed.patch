+// Ely: whether some non-empty selected paragraph is listed.
+static bool lcl_SomeParaListed(SwWrtShell& rSh, bool bBullet)
+{
+    for (SwPaM& rPaM : rSh.GetCursor()->GetRingContainer())
+    {
+        SwNodeOffset nEnd = rPaM.End()->GetNodeIndex();
+        for (SwNodeOffset nPos = rPaM.Start()->GetNodeIndex(); nPos <= nEnd; ++nPos)
+        {
+            SwTextNode* pTextNd = rSh.GetDoc()->GetNodes()[nPos]->GetTextNode();
+            if (!pTextNd || !pTextNd->Len())
+                continue;
+            pTextNd = sw::GetParaPropsNode(*rSh.GetLayout(), *pTextNd);
+            const bool bListed = bBullet ? pTextNd->HasBullet()
+                                         : pTextNd->HasNumber()
+                                               && (pTextNd->GetNumRule() != rSh.GetDoc()->GetOutlineNumRule()
+                                                   || pTextNd->IsCountedInList());
+            if (bListed)
+                return true;
+        }
+    }
+    return false;
+}
