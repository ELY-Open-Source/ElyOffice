+namespace
+{
+/// Ely: `rStyle` by its programmatic name; empty is Standard.
+SwTextFormatColl* lcl_ElyParaStyle(SwDoc& rDoc, const OUString& rStyle)
+{
+    const ProgName aName(rStyle.isEmpty() ? u"Standard"_ustr : rStyle);
+    const sal_uInt16 nId = SwStyleNameMapper::GetPoolIdFromProgName(aName, SwGetPoolIdFromName::TxtColl);
+    if (nId != USHRT_MAX)
+        return rDoc.getIDocumentStylePoolAccess().GetTextCollFromPool(nId);
+    return rDoc.FindTextFormatCollByName(UIName(aName.toString()));
+}
+
+/// Ely: `rText`'s lines after the body, one undo step.
+bool lcl_ElyAppend(SwDoc& rDoc, const OUString& rText, const OUString& rStyle)
+{
+    SwTextFormatColl* pColl = lcl_ElyParaStyle(rDoc, rStyle);
+    if (!pColl)
+        return false;
+    IDocumentContentOperations& rOps = rDoc.getIDocumentContentOperations();
+    // The last body node: a paragraph or a table's end.
+    SwPosition aPos(rDoc.GetNodes().GetEndOfContent(), SwNodeOffset(-1));
+    rDoc.GetIDocumentUndoRedo().StartUndo(SwUndoId::INSERT, nullptr);
+    sal_Int32 nIndex = 0;
+    do
+    {
+        const OUString aLine(o3tl::getToken(rText, 0, '\n', nIndex));
+        rOps.AppendTextNode(aPos);
+        const SwPaM aPara(aPos);
+        // Not the last paragraph's direct formats, nor its list.
+        rDoc.SetTextFormatColl(aPara, pColl, true, true);
+        if (!aLine.isEmpty())
+            rOps.InsertString(aPara, aLine);
+    } while (nIndex >= 0);
+    rDoc.GetIDocumentUndoRedo().EndUndo(SwUndoId::INSERT, nullptr);
+    return true;
+}
+}
