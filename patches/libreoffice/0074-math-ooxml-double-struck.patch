+// Unicode's double-struck letter or digit; 0 for others.
+static sal_uInt32 lcl_doubleStruck(sal_Unicode c)
+{
+    if (c == 'H')
+        return 0x210D;
+    if (c == 'P')
+        return 0x2119;
+    if (c >= 'A' && c <= 'Z')
+        return 0x1D538 + (c - 'A');
+    if (c >= 'a' && c <= 'z')
+        return 0x1D552 + (c - 'a');
+    if (c >= '0' && c <= '9')
+        return 0x1D7D8 + (c - '0');
+    return 0;
+}
