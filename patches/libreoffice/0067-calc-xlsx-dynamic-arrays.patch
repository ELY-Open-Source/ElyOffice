+/** xl/metadata.xml: which cell metadata indexes (cm) mark dynamic arrays. */
+class MetadataFragment : public WorkbookFragmentBase
+{
+public:
+    explicit MetadataFragment( const WorkbookHelper& rHelper, const OUString& rFragmentPath );
