+
+ContextHandlerRef MetadataFragment::onCreateContext( sal_Int32 nElement, const AttributeList& rAttribs )
+{
+    switch( getCurrentElement() )
+    {
+        case XML_ROOT_CONTEXT:
+            if( nElement == XLS_TOKEN( metadata ) )
+            {
+                mbRead = true;
+                return this;
+            }
+        break;
+        case XLS_TOKEN( metadata ):
+            if( nElement == XLS_TOKEN( metadataTypes ) || nElement == XLS_TOKEN( cellMetadata ) )
+                return this;
+            if( nElement == XLS_TOKEN( futureMetadata ) )
+            {
+                mbInArrays = rAttribs.getString( XML_name, OUString() ) == "XLDAPR";
+                return this;
+            }
+        break;
+        case XLS_TOKEN( metadataTypes ):
+            if( nElement == XLS_TOKEN( metadataType ) )
+                maTypes.push_back( rAttribs.getString( XML_name, OUString() ) );
+        break;
+        case XLS_TOKEN( futureMetadata ):
+            if( nElement == XLS_TOKEN( bk ) && mbInArrays )
+            {
+                maDynamic.push_back( false );
+                return this;
+            }
+        break;
+        case XLS_TOKEN( cellMetadata ):
+            if( nElement == XLS_TOKEN( bk ) )
+            {
+                maCells.emplace_back( 0, -1 );
+                return this;
+            }
+        break;
+        case XLS_TOKEN( bk ):
+            if( nElement == XLS_TOKEN( extLst ) )
+                return this;
+            // Only a block's first record names its type.
+            if( nElement == XLS_TOKEN( rc ) && !maCells.empty() && maCells.back().first == 0 )
+                maCells.back() = { rAttribs.getInteger( XML_t, 0 ), rAttribs.getInteger( XML_v, -1 ) };
+        break;
+        case XLS_TOKEN( extLst ):
+            if( nElement == XLS_TOKEN( ext ) )
+                return this;
+        break;
+        case XLS_TOKEN( ext ):
+            if( nElement == OOX_TOKEN( xda, dynamicArrayProperties ) && !maDynamic.empty() )
+                maDynamic.back() = rAttribs.getBool( XML_fDynamic, false );
+        break;
+    }
+    return nullptr;
+}
+
+void MetadataFragment::finalizeImport()
+{
+    for( size_t nCell = 0; nCell < maCells.size(); ++nCell )
+    {
+        const auto [nType, nValue] = maCells[ nCell ];
+        if( nType < 1 || o3tl::make_unsigned( nType ) > maTypes.size() || maTypes[ nType - 1 ] != "XLDAPR" )
+            continue;
+        if( nValue >= 0 && o3tl::make_unsigned( nValue ) < maDynamic.size() && maDynamic[ nValue ] )
+            getFormulaBuffer().setDynamicCellMeta( static_cast< sal_Int32 >( nCell + 1 ) );
+    }
+}
