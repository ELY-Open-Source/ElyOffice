+// One XLDAPR block, as Excel writes it.
+void ExcDocument::WriteDynamicArrayMetadata( XclExpXmlStream& rStrm )
+{
+    sax_fastparser::FSHelperPtr pMeta = rStrm.CreateOutputStream(
+        u"xl/metadata.xml"_ustr, u"metadata.xml", rStrm.GetCurrentStream()->getOutputStream(),
+        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheetMetadata+xml",
+        oox::getRelationship(Relationship::SHEETMETADATA));
+    rStrm.PushStream(pMeta);
+    pMeta->startElement(XML_metadata, XML_xmlns, rStrm.getNamespaceURL(OOX_NS(xls)),
+                        FSNS(XML_xmlns, XML_xda), rStrm.getNamespaceURL(OOX_NS(xda)));
+    pMeta->startElement(XML_metadataTypes, XML_count, "1");
+    pMeta->singleElement(XML_metadataType, XML_name, "XLDAPR", XML_minSupportedVersion, "120000",
+                         XML_copy, "1", XML_pasteAll, "1", XML_pasteValues, "1", XML_merge, "1",
+                         XML_splitFirst, "1", XML_rowColShift, "1", XML_clearFormats, "1",
+                         XML_clearComments, "1", XML_assign, "1", XML_coerce, "1",
+                         XML_cellMeta, "1");
+    pMeta->endElement(XML_metadataTypes);
+    pMeta->startElement(XML_futureMetadata, XML_name, "XLDAPR", XML_count, "1");
+    pMeta->startElement(XML_bk);
+    pMeta->startElement(XML_extLst);
+    pMeta->startElement(XML_ext, XML_uri, "{bdbb8cdc-fa1e-496e-a857-3c3f30c029c3}");
+    pMeta->singleElementNS(XML_xda, XML_dynamicArrayProperties, XML_fDynamic, "1",
+                           XML_fCollapsed, "0");
+    pMeta->endElement(XML_ext);
+    pMeta->endElement(XML_extLst);
+    pMeta->endElement(XML_bk);
+    pMeta->endElement(XML_futureMetadata);
+    pMeta->startElement(XML_cellMetadata, XML_count, "1");
+    pMeta->startElement(XML_bk);
+    pMeta->singleElement(XML_rc, XML_t, "1", XML_v, "0");
+    pMeta->endElement(XML_bk);
+    pMeta->endElement(XML_cellMetadata);
+    pMeta->endElement(XML_metadata);
+    rStrm.PopStream();
+}
