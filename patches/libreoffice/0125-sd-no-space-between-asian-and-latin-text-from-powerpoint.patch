+#include <editeng/scriptspaceitem.hxx>
+#include <svl/itempool.hxx>
 #include <editeng/editeng.hxx>
 #include <svx/svdoutl.hxx>
 #include <svx/xfillit0.hxx>
@@ -1252,6 +1254,9 @@ bool ImplSdPPTImport::Import()
