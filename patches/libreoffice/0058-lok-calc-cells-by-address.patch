 namespace
 {
+/// One cell named with its sheet: shown text and input.
+void lcl_CellAt(tools::JsonWriter& rJson, ScDocument& rDoc, std::string_view rCommand)
+{
+    std::map<OUString, OUString> aMap
+        = SfxLokHelper::parseCommandParameters(OUString::fromUtf8(rCommand));
+    const ScAddress::Details aDetails(rDoc.GetAddressConvention(), 0, 0);
+    ScAddress aPos;
+    const ScRefFlags nFlags = aPos.Parse(aMap[u"address"_ustr], rDoc, aDetails);
+    rJson.put("commandName", ".uno:CellAt");
+    // The sheet must be named: the shown one changes.
+    if (!(nFlags & ScRefFlags::VALID) || !(nFlags & ScRefFlags::TAB_3D) || !rDoc.HasTable(aPos.Tab()))
+        return rJson.put("error", "address");
+    rJson.put("address", aPos.Format(ScRefFlags::ADDR_ABS_3D, &rDoc, aDetails));
+    rJson.put("text", rDoc.GetString(aPos));
+    const bool bFormula = rDoc.GetCellType(aPos) == CELLTYPE_FORMULA;
+    rJson.put("input", bFormula ? rDoc.GetFormula(aPos.Col(), aPos.Row(), aPos.Tab())
+                                : rDoc.GetInputString(aPos.Col(), aPos.Row(), aPos.Tab()));
+}
