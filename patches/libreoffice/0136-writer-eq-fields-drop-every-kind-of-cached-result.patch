+bool DomainMapper_Impl::IsInEqResult(bool bOuterOnly) const
+{
+    // EQ is drawn from its code; Word's cached result goes.
+    auto itEnd = m_aFieldStack.end();
+    if (bOuterOnly && itEnd != m_aFieldStack.begin())
+        --itEnd;
+    return std::any_of(m_aFieldStack.begin(), itEnd, [](const FieldContextPtr& pField) {
+        return pField->GetFieldId() == FIELD_EQ && pField->IsCommandCompleted();
+    });
+}
