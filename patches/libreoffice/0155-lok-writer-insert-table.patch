+/// Ely: the body node after the first match's block.
+SwNode* lcl_ElyAfterMatch(SwDoc& rDoc, const OUString& rFind)
+{
+    SwNodes& rNodes = rDoc.GetNodes();
+    const SwNode* pBody = rNodes.GetEndOfContent().StartOfSectionNode();
+    for (SwNodeOffset n = rNodes.GetEndOfExtras().GetIndex() + 1; n < rNodes.GetEndOfContent().GetIndex(); ++n)
+    {
+        SwTextNode* pText = rNodes[n]->GetTextNode();
+        if (!pText || pText->GetText().indexOf(rFind) < 0)
+            continue;
+        // A match in a table: after the whole table.
+        const SwNode* pTop = pText;
+        while (pTop->StartOfSectionNode() != pBody)
+            pTop = pTop->StartOfSectionNode();
+        const SwNodeOffset nLast = pTop->IsStartNode() ? pTop->EndOfSectionIndex() : pTop->GetIndex();
+        return rNodes[nLast + 1];
+    }
+    return nullptr;
+}
+
+/// Ely: rows split by U+001E, cells by U+001F.
+bool lcl_ElyInsertTable(SwDoc& rDoc, const OUString& rCells, const OUString& rAfter, bool bHeader)
+{
+    std::vector<std::vector<OUString>> aRows;
+    sal_Int32 nRow = 0;
+    do
+    {
+        const OUString aRow(o3tl::getToken(rCells, 0, u'', nRow));
+        std::vector<OUString>& rRow = aRows.emplace_back();
+        sal_Int32 nCell = 0;
+        do
+            rRow.emplace_back(o3tl::getToken(aRow, 0, u'', nCell));
+        while (nCell >= 0);
+    } while (nRow >= 0);
+    const size_t nCols = aRows[0].size();
+    if (aRows.size() > SAL_MAX_UINT16 || nCols > SAL_MAX_UINT16)
+        return false;
+    for (const auto& rRow : aRows)
+        if (rRow.size() != nCols)
+            return false;
+    SwNode* pBefore = rAfter.isEmpty() ? &rDoc.GetNodes().GetEndOfContent() : lcl_ElyAfterMatch(rDoc, rAfter);
+    if (!pBefore)
+        return false;
+    IDocumentContentOperations& rOps = rDoc.getIDocumentContentOperations();
+    rDoc.GetIDocumentUndoRedo().StartUndo(SwUndoId::INSTABLE, nullptr);
+    // At the end, a paragraph still follows the table.
+    if (pBefore == &rDoc.GetNodes().GetEndOfContent())
+    {
+        SwPosition aLast(rDoc.GetNodes().GetEndOfContent(), SwNodeOffset(-1));
+        rOps.AppendTextNode(aLast);
+        pBefore = &aLast.GetNode();
+        rDoc.SetTextFormatColl(SwPaM(aLast), rDoc.getIDocumentStylePoolAccess().GetTextCollFromPool(RES_POOLCOLL_STANDARD), true, true);
+    }
+    const SwInsertTableOptions aOptions(bHeader ? SwInsertTableFlags::All : SwInsertTableFlags::DefaultBorder, bHeader ? 1 : 0);
+    const SwTable* pTable = rDoc.InsertTable(aOptions, SwPosition(*pBefore), aRows.size(), nCols,
+                                             css::text::HoriOrientation::FULL);
+    if (pTable)
+        for (size_t r = 0; r < aRows.size(); ++r)
+            for (size_t c = 0; c < nCols; ++c)
+                if (!aRows[r][c].isEmpty())
+                {
+                    const SwStartNode* pBox = pTable->GetTabLines()[r]->GetTabBoxes()[c]->GetSttNd();
+                    rOps.InsertString(SwPaM(*pBox, SwNodeOffset(1)), aRows[r][c]);
+                }
+    rDoc.GetIDocumentUndoRedo().EndUndo(SwUndoId::INSTABLE, nullptr);
+    return pTable != nullptr;
+}
 }
 
