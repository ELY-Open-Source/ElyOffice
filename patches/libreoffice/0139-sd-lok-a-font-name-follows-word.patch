+SvtScriptType View::GetKitFontScripts(const OUString& rName) const
+{
+    // Western always, CJK when it has glyphs.
+    SvtScriptType nScripts = (GetScriptType() & SvtScriptType::COMPLEX) | SvtScriptType::LATIN;
+    const OutputDevice* pDev = GetFirstOutputDevice();
+    if (pDev && pDev->IsFontAvailable(rName)
+        && pDev->HasGlyphs(vcl::Font(rName, Size(0, 12)), u"\u4E2D\u6587") == -1)
+        nScripts |= SvtScriptType::ASIAN;
+    return nScripts;
+}
