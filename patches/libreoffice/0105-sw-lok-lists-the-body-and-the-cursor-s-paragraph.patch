+/// getCommandValues(".uno:ElyReading"): the body and the cursor's paragraph.
+void GetReading(tools::JsonWriter& rJsonWriter, SwDocShell* pDocShell)
+{
+    SwWrtShell* pWrtShell = pDocShell->GetWrtShell();
+    if (!pWrtShell)
+        return;
+    // Text typed into a shape is not the body's.
+    const SdrView* pDrawView = pWrtShell->GetDrawView();
+    if (pDrawView && pDrawView->IsTextEdit())
+        return;
+    const SwNodes& rNodes = pDocShell->GetDoc()->GetNodes();
+    const SwNodeOffset nCursor = pWrtShell->GetCursor()->GetPoint()->GetNodeIndex();
+    sal_Int32 nListed = 0;
+    sal_Int32 nCaret = -1;
+    {
+        auto aParagraphs = rJsonWriter.startArray("paragraphs");
+        // Footnotes, headers and frames lie before the body.
+        for (SwNodeOffset n = rNodes.GetEndOfExtras().GetIndex();
+             n < rNodes.GetEndOfContent().GetIndex(); ++n)
+        {
+            const SwTextNode* pText = rNodes[n]->GetTextNode();
+            if (!pText || !pText->getLayoutFrame(pWrtShell->GetLayout()))
+                continue;
+            if (n == nCursor)
+                nCaret = nListed;
+            rJsonWriter.putSimpleValue(pText->GetExpandText(pWrtShell->GetLayout()));
+            ++nListed;
+        }
+    }
+    // A cursor outside the body names no paragraph.
+    if (nCaret >= 0)
+        rJsonWriter.put("caret", nCaret);
+}
