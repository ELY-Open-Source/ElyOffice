     return nullptr;
 }
 
+bool ely::AskPrinterQueues(const char* pWhy)
+{
+    if( !bSkipQueueList && !bSkipDefaultPrinter )
+        return false;
+    ELY_INFO("vcl.print", pWhy << "; asking the spooler");
+    // The skipped list is empty; no printer points into it.
+    if( bSkipQueueList )
+        ImplDeletePrnQueueList();
+    bSkipQueueList = false;
+    bSkipDefaultPrinter = false;
+    return true;
+}
