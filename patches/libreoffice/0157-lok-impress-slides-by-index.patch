+        SdPage* pPage = rDoc.GetSdPage(i, PageKind::Standard);
+        auto pTitle = dynamic_cast<SdrTextObj*>(pPage->GetPresObj(PresObjKind::Title));
+        const OutlinerParaObject* pText
+            = pTitle && !pTitle->IsEmptyPresObj() ? pTitle->GetOutlinerParaObject() : nullptr;
+        auto aOne = rJson.startStruct();
+        rJson.put("name", pPage->GetName());
+        rJson.put("layout", static_cast<sal_Int32>(pPage->GetAutoLayout()));
+        rJson.put("title", pText ? pText->GetTextObject().GetText(LINEEND_LF) : OUString());
+        rJson.put("hidden", pPage->IsExcluded());
+    }
+}
