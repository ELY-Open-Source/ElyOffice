+/// Every slide's name, layout, title and whether hidden.
+void lcl_ElySlides(::tools::JsonWriter& rJson, SdDrawDocument& rDoc)
+{
+    auto aList = rJson.startArray("slides");
+    for (sal_uInt16 i = 0; i < rDoc.GetSdPageCount(PageKind::Standard); ++i)
