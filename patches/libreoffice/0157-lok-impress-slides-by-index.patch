+namespace
+{
+/// Undo for the new slide at nIndex and its notes.
+void lcl_ElyNewSlide(SdDrawDocument& rDoc, sal_uInt16 nIndex)
+{
+    rDoc.AddUndo(rDoc.GetSdrUndoFactory().CreateUndoNewPage(*rDoc.GetSdPage(nIndex, PageKind::Standard)));
+    rDoc.AddUndo(rDoc.GetSdrUndoFactory().CreateUndoNewPage(*rDoc.GetSdPage(nIndex, PageKind::Notes)));
+}
+
+/// Moves slide nSlide to index nTo; only it marked meanwhile.
+bool lcl_ElyMoveSlide(SdDrawDocument& rDoc, sal_uInt16 nSlide, sal_uInt16 nTo)
+{
+    const sal_uInt16 nCount = rDoc.GetSdPageCount(PageKind::Standard);
+    std::vector<bool> aMarked(nCount);
+    for (sal_uInt16 i = 0; i < nCount; ++i)
+    {
+        SdPage* pPage = rDoc.GetSdPage(i, PageKind::Standard);
+        aMarked[i] = pPage->IsSelected();
+        rDoc.SetSelected(pPage, i == nSlide);
+    }
+    std::vector<SdPage*> aPages(nCount);
+    for (sal_uInt16 i = 0; i < nCount; ++i)
+        aPages[i] = rDoc.GetSdPage(i, PageKind::Standard);
+    // MovePages puts it after a slide; -1 means first.
+    const sal_uInt16 nAfter = nTo > nSlide ? nTo : sal_uInt16(nTo - 1);
+    const bool bMoved = rDoc.MovePages(nAfter, { aPages[nSlide] });
+    for (sal_uInt16 i = 0; i < nCount; ++i)
+        rDoc.SetSelected(aPages[i], aMarked[i]);
+    return bMoved;
+}
+
+/// Adds, duplicates, deletes or moves a slide by index.
+bool lcl_ElySlide(SdDrawDocument& rDoc, std::u16string_view aVerb, sal_Int32 nSlide, sal_Int32 nValue)
+{
+    const sal_Int32 nCount = rDoc.GetSdPageCount(PageKind::Standard);
+    const bool bAdd = aVerb == u"add";
+    if (nSlide < 0 || nSlide > (bAdd ? nCount : nCount - 1))
+        return false;
+    if (aVerb == u"move")
+        return nValue >= 0 && nValue < nCount && nValue != nSlide
+               && lcl_ElyMoveSlide(rDoc, nSlide, nValue);
+    if (aVerb == u"delete")
+    {
+        if (nCount < 2)
+            return false;
+        SdPage* pPage = rDoc.GetSdPage(nSlide, PageKind::Standard);
+        const sal_uInt16 nPage = pPage->GetPageNum();
+        SdPage* pNotes = static_cast<SdPage*>(rDoc.GetPage(nPage + 1));
+        // As SdDrawPagesAccess::remove: notes undo first.
+        rDoc.BegUndo(SdResId(STR_UNDO_DELETEPAGES));
+        rDoc.AddUndo(rDoc.GetSdrUndoFactory().CreateUndoDeletePage(*pNotes));
+        rDoc.AddUndo(rDoc.GetSdrUndoFactory().CreateUndoDeletePage(*pPage));
+        rDoc.RemovePage(nPage);
+        rDoc.RemovePage(nPage);
+        rDoc.EndUndo();
+        return true;
+    }
+    if (aVerb == u"duplicate")
+    {
+        const sal_uInt16 nNew = rDoc.DuplicatePage(nSlide);
+        if (nNew == 0xffff)
+            return false;
+        rDoc.BegUndo(SdResId(STR_INSERTPAGE));
+        lcl_ElyNewSlide(rDoc, nNew);
+        rDoc.EndUndo();
+        return true;
+    }
+    if (!bAdd || nValue < AUTOLAYOUT_START || nValue >= AUTOLAYOUT_END)
+        return false;
+    // The new slide copies size and master from its neighbour.
+    SdPage* pBeside = rDoc.GetSdPage(nSlide > 0 ? nSlide - 1 : 0, PageKind::Standard);
+    SdrLayerAdmin& rLayers = rDoc.GetLayerAdmin();
+    const SdrLayerIDSet aShown = pBeside->TRG_GetMasterPageVisibleLayers();
+    // Outside the undo group: object undo would switch slides.
+    const sal_uInt16 nNew = rDoc.CreatePage(
+        pBeside, PageKind::Standard, OUString(), OUString(), static_cast<AutoLayout>(nValue),
+        AUTOLAYOUT_NOTES, aShown.IsSet(rLayers.GetLayerID(sUNO_LayerName_background)),
+        aShown.IsSet(rLayers.GetLayerID(sUNO_LayerName_background_objects)), 2 * nSlide + 1);
+    if (nNew == 0xffff)
+        return false;
+    rDoc.BegUndo(SdResId(STR_INSERTPAGE));
+    lcl_ElyNewSlide(rDoc, nNew);
+    rDoc.EndUndo();
+    return true;
+}
+}
