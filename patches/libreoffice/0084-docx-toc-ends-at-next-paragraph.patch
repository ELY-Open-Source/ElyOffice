+/// Marks the paragraph after a TOC as holding its end.
+static void lcl_MarkTOCEnd(const uno::Reference<text::XTextRange>& xParagraph)
+{
+    uno::Reference<text::XTextCursor> xCursor = xParagraph->getText()->createTextCursorByRange(xParagraph->getStart());
+    auto pCursor = dynamic_cast<SwXTextCursor*>(xCursor.get());
+    SwPaM* pPaM = pCursor ? pCursor->GetPaM() : nullptr;
+    const SwNode* pNode = pPaM ? &pPaM->GetPointNode() : nullptr;
+    const SwNode* pBefore = pNode ? pNode->GetNodes()[pNode->GetIndex() - SwNodeOffset(1)] : nullptr;
+    const SwSectionNode* pTOC = pBefore && pBefore->IsEndNode() ? pBefore->StartOfSectionNode()->GetSectionNode() : nullptr;
+    if (!pTOC || pTOC->GetSection().GetType() != SectionType::ToxContent)
+    {
+        SAL_WARN("writerfilter.dmapper", "TOC end paragraph is not after its TOC");
+        return;
+    }
+    uno::Reference<beans::XPropertySet> xProps(xParagraph, uno::UNO_QUERY_THROW);
+    comphelper::SequenceAsHashMap aBag(xProps->getPropertyValue(u"ParaInteropGrabBag"_ustr));
+    aBag[u"TOCFieldEnd"_ustr] <<= true;
+    xProps->setPropertyValue(u"ParaInteropGrabBag"_ustr, uno::Any(aBag.getAsConstPropertyValueList()));
+}
