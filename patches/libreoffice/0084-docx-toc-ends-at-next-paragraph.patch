+const SwTextNode* MSWordExportBase::TOCEndParagraph(const SwSectionNode& rSectionNode) const
+{
+    const SwTOXBase* pTOX = rSectionNode.GetSection().GetTOXBase();
+    if (GetExportFormat() != ExportFormat::DOCX || !pTOX || pTOX->GetType() != TOX_CONTENT)
+        return nullptr;
+    // An empty last paragraph already ends it, as Word does.
+    const SwNodes& rNodes = m_rDoc.GetNodes();
+    const SwTextNode* pLast = rNodes[rSectionNode.EndOfSectionIndex() - 1]->GetTextNode();
+    const SwNodeOffset nNext = rSectionNode.EndOfSectionIndex() + 1;
+    if (!pLast || pLast->GetText().isEmpty() || nNext > m_nCurEnd)
+        return nullptr;
+    const SwTextNode* pNext = rNodes[nNext]->GetTextNode();
+    // Only the import's end paragraph, never body text
+    const SfxGrabBagItem* pBag = pNext ? pNext->GetSwAttrSet().GetItemIfSet(RES_PARATR_GRABBAG, false) : nullptr;
+    return pBag && pBag->GetGrabBag().contains(u"TOCFieldEnd"_ustr) ? pNext : nullptr;
+}
