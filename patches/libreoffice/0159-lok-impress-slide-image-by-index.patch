+/// Centers a picture file on a slide, fitted to it.
+bool lcl_ElySlideImage(SdDrawDocument& rDoc, sal_Int32 nSlide, const OUString& rUrl, const OUString& rWidth)
+{
+    if (nSlide < 0 || nSlide >= rDoc.GetSdPageCount(PageKind::Standard))
+        return false;
+    Graphic aGraphic;
+    if (GraphicFilter::LoadGraphic(rUrl, OUString(), aGraphic) != ERRCODE_NONE || aGraphic.IsNone())
+        return false;
+    const MapMode aMm(MapUnit::Map100thMM);
+    const MapMode aPref(aGraphic.GetPrefMapMode());
+    const Size aNatural = aPref.GetMapUnit() == MapUnit::MapPixel
+        ? Application::GetDefaultDevice()->PixelToLogic(aGraphic.GetPrefSize(), aMm)
+        : OutputDevice::LogicToLogic(aGraphic.GetPrefSize(), aPref, aMm);
+    if (aNatural.Width() <= 0 || aNatural.Height() <= 0)
+        return false;
+    // Width comes in twips; empty keeps the natural size.
+    const sal_Int64 nAsked = rWidth.isEmpty() ? aNatural.Width()
+        : o3tl::convert(rWidth.toInt64(), o3tl::Length::twip, o3tl::Length::mm100);
+    if (nAsked <= 0)
+        return false;
+    SdPage* pPage = rDoc.GetSdPage(static_cast<sal_uInt16>(nSlide), PageKind::Standard);
+    const Size aRoom(pPage->GetSize().Width() - pPage->GetLeftBorder() - pPage->GetRightBorder(),
+                     pPage->GetSize().Height() - pPage->GetUpperBorder() - pPage->GetLowerBorder());
+    const double fHigh = double(aNatural.Height()) / aNatural.Width();
+    const double fWide = std::min({ double(nAsked), double(aRoom.Width()), aRoom.Height() / fHigh });
+    const Size aSize(std::max<tools::Long>(1, fWide), std::max<tools::Long>(1, fWide * fHigh));
+    const Point aAt(pPage->GetLeftBorder() + (aRoom.Width() - aSize.Width()) / 2,
+                    pPage->GetUpperBorder() + (aRoom.Height() - aSize.Height()) / 2);
+    rtl::Reference<SdrGrafObj> pObj = new SdrGrafObj(rDoc, aGraphic, ::tools::Rectangle(aAt, aSize));
+    rDoc.BegUndo(SdResId(STR_INSERTGRAPHIC));
+    pPage->InsertObject(pObj.get());
+    rDoc.AddUndo(rDoc.GetSdrUndoFactory().CreateUndoNewObject(*pObj));
+    rDoc.EndUndo();
+    return true;
+}
