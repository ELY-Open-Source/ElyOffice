+/// Cells showing the file's result: Calc cannot compute their formula.
+void lcl_KeptResults(tools::JsonWriter& rJson, ScDocument& rDoc)
+{
+    rJson.put("commandName", ".uno:KeptResults");
+    const ScAddress::Details aDetails(rDoc.GetAddressConvention(), 0, 0);
+    auto aArray = rJson.startArray("cells");
+    for (SCTAB nTab = 0; nTab < rDoc.GetTableCount(); ++nTab)
+    {
+        ScCellIterator aIter(rDoc, ScRange(0, 0, nTab, rDoc.MaxCol(), rDoc.MaxRow(), nTab));
+        for (bool bHas = aIter.first(); bHas; bHas = aIter.next())
+        {
+            if (aIter.getType() == CELLTYPE_FORMULA && aIter.getFormulaCell()->IsKeptResult())
+                rJson.putSimpleValue(aIter.GetPos().Format(ScRefFlags::VALID | ScRefFlags::TAB_3D, &rDoc, aDetails));
+        }
+    }
+}
