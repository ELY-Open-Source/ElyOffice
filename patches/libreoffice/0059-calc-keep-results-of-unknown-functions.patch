+/// A formula naming what Calc lacks keeps the file's result.
+void keepIfUnknown(ScFormulaCell& rCell, bool bLogical = false)
+{
+    if (rCell.GetCode()->HasOpCode(ocBad))
+        rCell.SetKeptResult(bLogical);
+}
+
+/// Whether the whole text is one number.
+bool isNumber(std::u16string_view aText)
+{
+    rtl_math_ConversionStatus eStatus = rtl_math_ConversionStatus_Ok;
+    sal_Int32 nEnd = 0;
+    rtl::math::stringToDouble(aText, '.', 0, &eStatus, &nEnd);
+    return !aText.empty() && eStatus == rtl_math_ConversionStatus_Ok && nEnd == sal_Int32(aText.size());
+}
+
+/// The file's results across an array, each one present.
+ScMatrixRef keptMatrix(ScDocument& rDoc, const ScRange& rRange,
+    const std::vector<FormulaBuffer::FormulaValue>& rValues, bool bStrings,
+    formula::FormulaConstTokenRef& rFirstToken)
+{
+    const ScAddress& rOrigin = rRange.aStart;
+    auto pFirst = std::find_if(rValues.begin(), rValues.end(),
+        [&rOrigin](const FormulaBuffer::FormulaValue& rValue) { return rValue.maAddress == rOrigin; });
+    if (pFirst == rValues.end())
+        return nullptr;
+    const SCSIZE nCols = rRange.aEnd.Col() - rOrigin.Col() + 1;
+    const SCSIZE nRows = rRange.aEnd.Row() - rOrigin.Row() + 1;
+    ScMatrixRef pMat(new ScMatrix(nCols, nRows));
+    const OUString& rFirst = pFirst->maValueStr;
+    if (pFirst->mnCellType == XML_n && isNumber(rFirst))
+        rFirstToken = new formula::FormulaDoubleToken(rFirst.toDouble());
+    else if (pFirst->mnCellType == XML_b && (rFirst == "1" || rFirst == "0"))
+        rFirstToken = new formula::FormulaDoubleToken(rFirst == "1" ? 1.0 : 0.0);
+    else if (pFirst->mnCellType == XML_str && bStrings)
+        rFirstToken = new formula::FormulaStringToken(rDoc.GetSharedStringPool().intern(rFirst));
+    else
+        return nullptr;
+    if (rFirstToken->GetType() == formula::svDouble)
+        pMat->PutDouble(rFirstToken->GetDouble(), 0, 0);
+    else
+        pMat->PutString(rFirstToken->GetString(), 0, 0);
+    // The other cells were loaded as plain values.
+    for (SCSIZE nRow = 0; nRow < nRows; ++nRow)
+        for (SCSIZE nCol = 0; nCol < nCols; ++nCol)
+        {
+            if (nCol == 0 && nRow == 0)
+                continue;
+            ScRefCellValue aCell(rDoc, ScAddress(rOrigin.Col() + nCol, rOrigin.Row() + nRow, rOrigin.Tab()));
+            if (aCell.getType() == CELLTYPE_VALUE)
+                pMat->PutDouble(aCell.getDouble(), nCol, nRow);
+            else if (aCell.getType() == CELLTYPE_STRING)
+                pMat->PutString(*aCell.getSharedString(), nCol, nRow);
+            else
+                return nullptr;
+        }
+    return pMat;
+}
