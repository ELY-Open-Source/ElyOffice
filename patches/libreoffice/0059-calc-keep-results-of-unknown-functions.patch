+/// A formula naming what Calc lacks keeps the file's result.
+void keepIfUnknown(ScFormulaCell& rCell, bool bLogical = false)
+{
+    if (rCell.GetCode()->HasOpCode(ocBad))
+        rCell.SetKeptResult(bLogical);
+}
+
+/// Whether the whole text is one number.
+bool isNumber(std::u16string_view aText)
+{
+    rtl_math_ConversionStatus eStatus = rtl_math_ConversionStatus_Ok;
+    sal_Int32 nEnd = 0;
+    rtl::math::stringToDouble(aText, '.', 0, &eStatus, &nEnd);
+    return !aText.empty() && eStatus == rtl_math_ConversionStatus_Ok && nEnd == sal_Int32(aText.size());
+}
+
+/// Booleans show as such unless the cell has a format.
+void setLogical(ScDocument& rDoc, const ScAddress& rPos)
+{
+    if (rDoc.GetNumberFormat(rPos.Col(), rPos.Row(), rPos.Tab()) % SV_COUNTRY_LANGUAGE_OFFSET == 0)
+        rDoc.SetNumberFormat(rPos, rDoc.GetFormatTable()->GetStandardFormat(SvNumFormatType::LOGICAL));
+}
+
+using KeptValues = std::unordered_map<ScAddress, const FormulaBuffer::FormulaValue*>;
+
+/// One file result into the matrix; false if unsound.
+bool putKept(ScDocument& rDoc, ScMatrix& rMat, SCSIZE nCol, SCSIZE nRow,
+    const FormulaBuffer::FormulaValue& rValue, bool bStrings)
+{
+    const OUString& rText = rValue.maValueStr;
+    switch (rValue.mnCellType)
+    {
+        case XML_n:
+            if (!isNumber(rText))
+                return false;
+            rMat.PutDouble(rText.toDouble(), nCol, nRow);
+            return true;
+        case XML_b:
+            if (rText != "1" && rText != "0")
+                return false;
+            rMat.PutBoolean(rText == "1", nCol, nRow);
+            return true;
+        case XML_str:
+            if (!bStrings)
+                return false;
+            rMat.PutString(rDoc.GetSharedStringPool().intern(rText), nCol, nRow);
+            return true;
+        case XML_s:
+        {
+            // A shared string was set as the cell's text.
+            ScRefCellValue aCell(rDoc, rValue.maAddress);
+            if (aCell.getType() != CELLTYPE_STRING)
+                return false;
+            rMat.PutString(*aCell.getSharedString(), nCol, nRow);
+            return true;
+        }
+    }
+    return false;
+}
+
+/// The file's array results, each present and sound.
+ScMatrixRef keptMatrix(ScDocument& rDoc, const ScRange& rRange, const KeptValues& rValues, bool bStrings)
+{
+    const SCSIZE nCols = rRange.aEnd.Col() - rRange.aStart.Col() + 1;
+    const SCSIZE nRows = rRange.aEnd.Row() - rRange.aStart.Row() + 1;
+    ScMatrixRef pMat(new ScMatrix(nCols, nRows));
+    for (SCSIZE nRow = 0; nRow < nRows; ++nRow)
+        for (SCSIZE nCol = 0; nCol < nCols; ++nCol)
+        {
+            const ScAddress aPos(rRange.aStart.Col() + nCol, rRange.aStart.Row() + nRow, rRange.aStart.Tab());
+            auto pValue = rValues.find(aPos);
+            if (pValue == rValues.end() || !putKept(rDoc, *pMat, nCol, nRow, *pValue->second, bStrings))
+                return nullptr;
+        }
+    return pMat;
+}
