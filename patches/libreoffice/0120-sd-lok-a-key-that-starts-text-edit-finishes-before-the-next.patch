                     else
                     {
-                        mrViewShell.GetViewFrame()->GetDispatcher()->Execute( SID_ATTR_CHAR, SfxCallMode::ASYNCHRON | SfxCallMode::RECORD );
+                        mrViewShell.GetViewFrame()->GetDispatcher()->Execute( SID_ATTR_CHAR, (comphelper::LibreOfficeKit::isActive() ? SfxCallMode::SYNCHRON : SfxCallMode::ASYNCHRON) | SfxCallMode::RECORD );
                     }
 
