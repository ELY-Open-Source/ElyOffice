 #include <svx/svdoole2.hxx>
 #include <svx/svdograf.hxx>
 #include <vcl/seleng.hxx>
+#include <comphelper/lok.hxx>
 #include <sfx2/dispatch.hxx>
 #include <sfx2/bindings.hxx>
 #include <sfx2/request.hxx>
@@ -253,7 +254,7 @@
