+namespace
+{
+/// Ely: one existing sheet's range, as `rAddress` names it.
+bool lcl_ElyRange(const ScDocument& rDoc, const OUString& rAddress, ScRange& rRange)
+{
+    const ScAddress::Details aDetails(rDoc.GetAddressConvention(), 0, 0);
+    const ScRefFlags nFlags = rRange.ParseAny(rAddress, rDoc, aDetails);
+    return (nFlags & ScRefFlags::VALID) && (nFlags & ScRefFlags::TAB_3D)
+           && rRange.aStart.Tab() == rRange.aEnd.Tab() && rDoc.HasTable(rRange.aStart.Tab());
+}
+
+/// Ely: the sheet before an address's last `!`, unquoted.
+OUString lcl_ElySheetOf(const OUString& rAddress)
+{
+    const sal_Int32 nBang = rAddress.lastIndexOf('!');
+    OUString aSheet = nBang < 0 ? rAddress : rAddress.copy(0, nBang);
+    if (aSheet.getLength() > 1 && aSheet.startsWith("'") && aSheet.endsWith("'"))
+        aSheet = aSheet.copy(1, aSheet.getLength() - 2).replaceAll("''", "'");
+    return aSheet;
+}
+
+/// Ely: why `rVerb` cannot run, empty if it can.
+OString lcl_ElyRefusal(const ScDocument& rDoc, std::u16string_view rVerb, const OUString& rAddress,
+                       const OUString& rValue, ScRange& rRange, OUString& rSheet)
+{
+    const SCTAB nCount = rDoc.GetTableCount();
+    SCTAB nTab = 0;
+    if (rVerb == u"sheet.add" || rVerb == u"sheet.remove" || rVerb == u"sheet.rename")
+    {
+        const bool bAdd = rVerb == u"sheet.add";
+        rSheet = rAddress;
+        if (!bAdd && !rDoc.GetTable(rAddress, nTab))
+            return "sheet"_ostr;
+        if (rDoc.IsDocProtected())
+            return "protected"_ostr;
+        const OUString& rName = bAdd ? rAddress : rValue;
+        if (rVerb != u"sheet.remove" && !ScDocument::ValidTabName(rName))
+            return "name"_ostr;
+        if (rVerb != u"sheet.remove" && !rDoc.ValidNewTabName(rName))
+            return "taken"_ostr;
+        if (bAdd)
+        {
+            const sal_Int32 nPos = rValue.isEmpty() ? nCount + 1 : rValue.toInt32();
+            if (nPos < 1 || nPos > nCount + 1)
+                return "position"_ostr;
+            nTab = static_cast<SCTAB>(nPos - 1);
+        }
+        SCTAB nVisible = 0;
+        for (SCTAB i = 0; i < nCount; ++i)
+            nVisible += rDoc.IsVisible(i) ? 1 : 0;
+        if (rVerb == u"sheet.remove" && (nCount < 2 || (rDoc.IsVisible(nTab) && nVisible < 2)))
+            return "last"_ostr;
+        rRange = ScRange(0, 0, nTab, 0, 0, nTab);
+        return {};
+    }
+    if (!lcl_ElyRange(rDoc, rAddress, rRange))
+    {
+        rSheet = lcl_ElySheetOf(rAddress);
+        return rDoc.GetTable(rSheet, nTab) ? "address"_ostr : "sheet"_ostr;
+    }
+    nTab = rRange.aStart.Tab();
+    rDoc.GetName(nTab, rSheet);
+    const bool bSingle = rRange.aStart == rRange.aEnd;
+    if (rVerb == u"sheet.freeze")
+        return bSingle ? OString() : "address"_ostr;
+    const bool bRows = o3tl::starts_with(rVerb, u"rows.");
+    const bool bColumns = o3tl::starts_with(rVerb, u"columns.");
+    if (bRows && (rRange.aStart.Col() != 0 || rRange.aEnd.Col() != rDoc.MaxCol()))
+        return "address"_ostr;
+    if (bColumns && (rRange.aStart.Row() != 0 || rRange.aEnd.Row() != rDoc.MaxRow()))
+        return "address"_ostr;
+    if (!bRows && !bColumns && rVerb != u"range.merge" && rVerb != u"range.unmerge")
+        return "verb"_ostr;
+    if (rDoc.IsTabProtected(nTab))
+        return "protected"_ostr;
+    if (rVerb == u"rows.insert" && !rDoc.CanInsertRow(rRange))
+        return "edge"_ostr;
+    if (rVerb == u"columns.insert" && !rDoc.CanInsertCol(rRange))
+        return "edge"_ostr;
+    if (rVerb == u"rows.height" || rVerb == u"columns.width")
+    {
+        const sal_Int32 nMax = rVerb == u"rows.height" ? MAX_ROW_HEIGHT : MAX_COL_WIDTH;
+        if (rValue != u"auto" && (rValue.toInt32() < 1 || rValue.toInt32() > nMax))
+            return "size"_ostr;
+    }
+    if (rVerb == u"range.merge" && bSingle)
+        return "single"_ostr;
+    if (rVerb == u"range.merge"
+        && rDoc.HasAttrib(rRange, HasAttrFlags::Merged | HasAttrFlags::Overlapped))
+        return "merged"_ostr;
+    if (rVerb == u"range.unmerge" && !rDoc.HasAttrib(rRange, HasAttrFlags::Merged))
+        return "unmerged"_ostr;
+    return {};
+}
+
+/// Ely: views refetch the sheet's sizes from `nStart` on.
+void lcl_ElyResized(ScDocShell& rDocShell, SCTAB nTab, bool bColumns, SCCOLROW nStart)
+{
+    if (!comphelper::LibreOfficeKit::isActive())
+        return;
+    const SfxViewShell* pAnyView = nullptr;
+    for (SfxViewShell* pShell = SfxViewShell::GetFirst(); pShell;
+         pShell = SfxViewShell::GetNext(*pShell))
+    {
+        auto* pView = dynamic_cast<ScTabViewShell*>(pShell);
+        if (!pView || pView->GetViewData().GetDocShell() != &rDocShell)
+            continue;
+        pAnyView = pView;
+        ScViewData& rData = pView->GetViewData();
+        ScPositionHelper* pHelper
+            = bColumns ? rData.GetLOKWidthHelper(nTab) : rData.GetLOKHeightHelper(nTab);
+        if (pHelper)
+            pHelper->invalidateByIndex(nStart);
+    }
+    if (!pAnyView)
+        return;
+    ScTabViewShell::notifyAllViewsHeaderInvalidation(pAnyView, bColumns ? COLUMN_HEADER : ROW_HEADER,
+                                                     nTab);
+    ScTabViewShell::notifyAllViewsSheetGeomInvalidation(pAnyView, bColumns, !bColumns, true, true,
+                                                        true, false, nTab);
+}
+
+/// Ely: freezes above and left of `rCell` on its sheet.
+bool lcl_ElyFreeze(ScDocShell& rDocShell, const ScAddress& rCell)
+{
+    ScDocument& rDoc = rDocShell.GetDocument();
+    const SCTAB nTab = rCell.Tab();
+    const bool bCol = rDoc.SetLOKFreezeCol(rCell.Col(), nTab);
+    const bool bRow = rDoc.SetLOKFreezeRow(rCell.Row(), nTab);
+    if (!bCol && !bRow)
+        return true;
+    // Views on that sheet ask for their panes again.
+    for (SfxViewShell* pShell = SfxViewShell::GetFirst(); pShell;
+         pShell = SfxViewShell::GetNext(*pShell))
+    {
+        auto* pView = dynamic_cast<ScTabViewShell*>(pShell);
+        if (!pView || pView->GetViewData().GetDocShell() != &rDocShell
+            || pView->GetViewData().CurrentTabForData() != nTab)
+            continue;
+        SfxBindings& rBindings = pView->GetViewData().GetBindings();
+        rBindings.Invalidate(SID_WINDOW_FIX);
+        rBindings.Invalidate(SID_WINDOW_FIX_COL);
+        rBindings.Invalidate(SID_WINDOW_FIX_ROW);
+    }
+    rDocShell.SetDocumentModified();
+    return true;
+}
+}
+
+void ScDocFunc::ElyStructureCheck(tools::JsonWriter& rJson, std::u16string_view rVerb,
+                                  const OUString& rAddress, const OUString& rValue)
+{
+    ScDocument& rDoc = rDocShell.GetDocument();
+    rJson.put("commandName", ".uno:StructureAt");
+    ScRange aRange;
+    OUString aSheet;
+    const OString aRefusal = lcl_ElyRefusal(rDoc, rVerb, rAddress, rValue, aRange, aSheet);
+    if (aRefusal.isEmpty())
+    {
+        const ScAddress::Details aDetails(rDoc.GetAddressConvention(), 0, 0);
+        return rJson.put("address", aRange.Format(rDoc, ScRefFlags::RANGE_ABS_3D, aDetails));
+    }
+    rJson.put("error", aRefusal);
+    rJson.put("sheet", aSheet);
+    rJson.put("last", static_cast<sal_Int64>(rDoc.GetTableCount() + 1));
+}
+
+bool ScDocFunc::ElyStructure(std::u16string_view rVerb, const OUString& rAddress,
+                             const OUString& rValue)
+{
+    ScDocument& rDoc = rDocShell.GetDocument();
+    ScRange aRange;
+    OUString aSheet;
+    if (!lcl_ElyRefusal(rDoc, rVerb, rAddress, rValue, aRange, aSheet).isEmpty())
+        return false;
+    const SCTAB nTab = aRange.aStart.Tab();
+    if (rVerb == u"sheet.add")
+        return InsertTable(nTab, rAddress, true, true);
+    if (rVerb == u"sheet.remove")
+        return DeleteTable(nTab, true);
+    if (rVerb == u"sheet.rename")
+        return RenameTable(nTab, rValue, true, true);
+    if (rVerb == u"sheet.freeze")
+        return lcl_ElyFreeze(rDocShell, aRange.aStart);
+    const bool bColumns = o3tl::starts_with(rVerb, u"columns.");
+    if (bColumns || o3tl::starts_with(rVerb, u"rows."))
+    {
+        bool bDone;
+        if (rVerb == u"rows.insert" || rVerb == u"columns.insert")
+            bDone = InsertCells(aRange, nullptr, bColumns ? INS_INSCOLS_BEFORE : INS_INSROWS_BEFORE,
+                                true, true);
+        else if (rVerb == u"rows.delete" || rVerb == u"columns.delete")
+            bDone = DeleteCells(aRange, nullptr, bColumns ? DelCellCmd::Cols : DelCellCmd::Rows,
+                                true);
+        else
+        {
+            const bool bAuto = rValue == u"auto";
+            std::vector<sc::ColRowSpan> aSpans{
+                bColumns ? sc::ColRowSpan(aRange.aStart.Col(), aRange.aEnd.Col())
+                         : sc::ColRowSpan(aRange.aStart.Row(), aRange.aEnd.Row())
+            };
+            // Auto: as a header edge's double click does.
+            const sal_uInt16 nTwips
+                = bAuto ? (bColumns ? STD_EXTRA_WIDTH : 0) : rValue.toInt32();
+            bDone = SetWidthOrHeight(bColumns, aSpans, nTab,
+                                     bAuto ? SC_SIZE_OPTIMAL : SC_SIZE_DIRECT, nTwips, true, true);
+        }
+        if (bDone)
+            lcl_ElyResized(rDocShell, nTab, bColumns,
+                           bColumns ? SCCOLROW(aRange.aStart.Col()) : SCCOLROW(aRange.aStart.Row()));
+        return bDone;
+    }
+    ScCellMergeOption aOption(aRange.aStart.Col(), aRange.aStart.Row(), aRange.aEnd.Col(),
+                              aRange.aEnd.Row());
+    aOption.maTabs.insert(nTab);
+    if (rVerb == u"range.merge")
+        return MergeCells(aOption, false, true, true);
+    return UnmergeCells(aOption, true, nullptr);
+}
+
