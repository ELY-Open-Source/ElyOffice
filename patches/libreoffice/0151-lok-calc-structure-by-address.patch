+/// Every sheet: its name, used area or null, hidden.
+void lcl_SheetsAt(tools::JsonWriter& rJson, ScDocument& rDoc)
+{
+    const ScAddress::Details aDetails(rDoc.GetAddressConvention(), 0, 0);
+    rJson.put("commandName", ".uno:SheetsAt");
+    auto aSheets = rJson.startArray("sheets");
+    for (SCTAB nTab = 0; nTab < rDoc.GetTableCount(); ++nTab)
+    {
+        auto aSheet = rJson.startStruct();
+        OUString aName;
+        rDoc.GetName(nTab, aName);
+        rJson.put("name", aName);
+        SCCOL nEndCol = 0;
+        SCROW nEndRow = 0;
+        // An empty sheet has no used area.
+        if (rDoc.GetCellArea(nTab, nEndCol, nEndRow))
+            rJson.put("used", ScRange(0, 0, nTab, nEndCol, nEndRow, nTab)
+                                  .Format(rDoc, ScRefFlags::RANGE_ABS_3D, aDetails));
+        rJson.put("hidden", !rDoc.IsVisible(nTab));
+    }
+}
