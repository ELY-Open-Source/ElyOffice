+namespace
+{
+    // Upper case copy for ICU sentence breaks; offsets unchanged.
+    OUString lcl_SentenceBreakText(const OUString& rText)
+    {
+        OUStringBuffer aBuf(rText.getLength());
+        for (sal_Int32 i = 0; i < rText.getLength();)
+        {
+            const sal_uInt32 c = rText.iterateCodePoints(&i);
+            const sal_uInt32 u = u_toupper(c);
+            aBuf.appendUtf32((c > 0xFFFF) == (u > 0xFFFF) ? u : c);
+        }
+        return aBuf.makeStringAndClear();
+    }
+}
