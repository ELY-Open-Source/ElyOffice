diff --git a/include/ely/log.hxx b/include/ely/log.hxx
new file mode 100644
index 0000000..2527019
--- /dev/null
+++ b/include/ely/log.hxx
@@ -0,0 +1,31 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+#include <sal/log.hxx>
+
+// Ely: kept in release builds; never document text.
+#define ELY_LOG_IF(condition, level, area, stream) \
+    do \
+    { \
+        if (SAL_UNLIKELY(condition)) \
+        { \
+            SAL_DETAIL_LOG_STREAM_PRIVATE_(level, "ely." area, SAL_WHERE, stream) \
+        } \
+    } while (false)
+
+#define ELY_INFO(area, stream) ELY_LOG_IF(true, ::SAL_DETAIL_LOG_LEVEL_INFO, area, stream)
+
+#define ELY_WARN(area, stream) ELY_LOG_IF(true, ::SAL_DETAIL_LOG_LEVEL_WARN, area, stream)
+
+#define ELY_WARN_IF(condition, area, stream) \
+    ELY_LOG_IF((condition), ::SAL_DETAIL_LOG_LEVEL_WARN, area, stream)
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
