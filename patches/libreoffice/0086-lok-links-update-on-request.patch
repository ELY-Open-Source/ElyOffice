+/// The file or server a link reads; empty inside.
+OUString LinkSource(const sfx2::SvBaseLink& rLink)
+{
+    OUString aServer, aFile;
+    if (!sfx2::LinkManager::GetDisplayNames(&rLink, &aServer, &aFile))
+        return OUString();
+    if (rLink.GetObjType() == sfx2::SvBaseLinkObjectType::ClientDde)
+        return aServer + "|" + aFile;
+    return aFile;
+}
+
+/// Implements getCommandValues(".uno:ExternalLinks").
+void GetExternalLinks(tools::JsonWriter& rJsonWriter, SwDocShell* pDocShell)
+{
+    std::set<OUString> aSources;
+    for (const auto& rLink :
+         pDocShell->GetDoc()->getIDocumentLinksAdministration().GetLinkManager().GetLinks())
+    {
+        if (OUString aSource = LinkSource(*rLink); !aSource.isEmpty())
+            aSources.insert(aSource);
+    }
+    auto aArray = rJsonWriter.startArray("links");
+    for (const OUString& rSource : aSources)
+        rJsonWriter.putSimpleValue(rSource);
+}
+
+/// Implements getCommandValues(".uno:ElyUpdateLinks"): each link reads again.
+void UpdateExternalLinks(tools::JsonWriter& rJsonWriter, SwDocShell* pDocShell)
+{
+    pDocShell->getEmbeddedObjectContainer().setUserAllowsLinkUpdate(true);
+    const sfx2::SvBaseLinks& rLinks
+        = pDocShell->GetDoc()->getIDocumentLinksAdministration().GetLinkManager().GetLinks();
+    // An update may add or drop links.
+    const std::vector<tools::SvRef<sfx2::SvBaseLink>> aLinks(rLinks.begin(), rLinks.end());
+    std::set<OUString> aFailed;
+    SwWrtShell* pShell = pDocShell->GetWrtShell();
+    if (pShell)
+        pShell->StartAllAction();
+    for (const auto& xLink : aLinks)
+    {
+        const OUString aSource = LinkSource(*xLink);
+        if (aSource.isEmpty())
+            continue;
+        // A missing file would empty a linked section.
+        const bool bFile = INetURLObject(aSource).GetProtocol() == INetProtocol::File;
+        if ((bFile && !FStatHelper::IsDocument(aSource)) || !xLink->Update())
+            aFailed.insert(aSource);
+    }
+    if (pShell)
+        pShell->EndAllAction();
+    rJsonWriter.put("commandName", ".uno:ElyUpdateLinks");
+    auto aArray = rJsonWriter.startArray("failed");
+    for (const OUString& rSource : aFailed)
+        rJsonWriter.putSimpleValue(rSource);
+}
 }
 
