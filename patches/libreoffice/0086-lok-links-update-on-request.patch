+namespace
+{
+/// The link's file as it reads it; null when unreadable.
+std::unique_ptr<ScDocumentLoader> lcl_Load(ScDocShell& rShell, const OUString& rFile,
+                                           OUString aFilter, OUString aOptions)
+{
+    const OUString aURL = ScGlobal::GetAbsDocName(rFile, &rShell);
+    if (!FStatHelper::IsDocument(aURL))
+        return nullptr;
+    ScDocumentLoader::RemoveAppPrefix(aFilter);
+    auto pLoader = std::make_unique<ScDocumentLoader>(aURL, aFilter, aOptions);
+    return pLoader->IsError() ? nullptr : std::move(pLoader);
+}
+
+/// Every sheet the link copies is in its file.
+bool lcl_SheetReadable(ScDocShell& rShell, const ScTableLink& rLink)
+{
+    auto pLoader = lcl_Load(rShell, rLink.GetFileName(), rLink.GetFilterName(), rLink.GetOptions());
+    if (!pLoader)
+        return false;
+    const ScDocument& rSrc = *pLoader->GetDocument();
+    // Text filters name no sheet: their one sheet is read.
+    if (rSrc.GetTableCount() == 1 && ScDocShell::HasAutomaticTableName(rLink.GetFilterName()))
+        return true;
+    const ScDocument& rDoc = rShell.GetDocument();
+    for (SCTAB nTab = 0; nTab < rDoc.GetTableCount(); ++nTab)
+    {
+        SCTAB nSrc;
+        const OUString aName = rDoc.GetLinkTab(nTab);
+        if (rDoc.GetLinkMode(nTab) != ScLinkMode::NONE && rDoc.GetLinkDoc(nTab) == rLink.GetFileName()
+            && !aName.isEmpty() && !rSrc.GetTable(aName, nSrc))
+            return false;
+    }
+    return true;
+}
+
+/// Every range the link copies is in its file.
+bool lcl_AreaReadable(ScDocShell& rShell, const ScAreaLink& rLink)
+{
+    auto pLoader = lcl_Load(rShell, rLink.GetFile(), rLink.GetFilter(), rLink.GetOptions());
+    if (!pLoader)
+        return false;
+    ScDocument& rSrc = *pLoader->GetDocument();
+    OUString aArea = rLink.GetSource();
+    // Calc reads a whole CSV only when it has cells.
+    if (rLink.GetFilter() == SC_TEXT_CSV_FILTER_NAME && aArea == "CSV_all")
+    {
+        SCCOL nEndCol = 0;
+        SCROW nEndRow = 0;
+        return rSrc.GetCellArea(0, nEndCol, nEndRow);
+    }
+    if (rLink.GetFilter() == ScDocShell::GetWebQueryFilterName())
+        aArea = ScFormatFilter::Get().GetHTMLRangeNameList(rSrc, aArea);
+    if (aArea.isEmpty())
+        return false;
+    sal_Int32 nIdx = 0;
+    do
+    {
+        ScRange aRange;
+        if (!ScAreaLink::FindExtRange(aRange, rSrc, aArea.getToken(0, ';', nIdx)))
+            return false;
+    } while (nIdx > 0);
+    return true;
+}
+}
+
+void ScDocShell::UpdateLinksAsked(std::vector<OUString>& rFailed)
+{
+    AllowLinkUpdate();
+    const sfx2::SvBaseLinks& rLinks = m_pDocument->GetLinkManager()->GetLinks();
+    // An update may add or drop links.
+    const std::vector<tools::SvRef<sfx2::SvBaseLink>> aLinks(rLinks.begin(), rLinks.end());
+    bool bSheets = false, bDde = false;
+    for (const auto& xLink : aLinks)
+    {
+        auto pSheet = dynamic_cast<ScTableLink*>(xLink.get());
+        auto pArea = dynamic_cast<ScAreaLink*>(xLink.get());
+        if (pSheet || pArea)
+        {
+            const OUString& rFile = pSheet ? pSheet->GetFileName() : pArea->GetFile();
+            // An unread source would overwrite the saved cells.
+            const bool bReadable = pSheet ? lcl_SheetReadable(*this, *pSheet) : lcl_AreaReadable(*this, *pArea);
+            if (!bReadable || !xLink->Update())
+            {
+                SAL_WARN("sc.ui", "linked source not read: " << rFile);
+                rFailed.push_back(rFile);
+                continue;
+            }
+            bSheets |= pSheet != nullptr;
+        }
+        else if (auto pDde = dynamic_cast<ScDdeLink*>(xLink.get()))
+        {
+            if (pDde->Update())
+                bDde = true;
+            else
+                rFailed.push_back(pDde->GetAppl() + "|" + pDde->GetTopic());
+        }
+        else if (auto pWeb = dynamic_cast<ScWebServiceLink*>(xLink.get()))
+        {
+            if (!pWeb->Update())
+                rFailed.push_back(pWeb->GetURL());
+        }
+    }
+    // Sources no formula has read yet are linked too.
+    m_pDocument->GetExternalRefManager()->addFilesToLinkManager();
+    m_pDocument->UpdateExternalRefLinks(GetActiveDialogParent(), &rFailed);
+    if (bDde)
+    {
+        m_pDocument->TrackFormulas();
+        Broadcast(SfxHint(SfxHintId::ScDataChanged));
+    }
+    if (bSheets)
+    {
+        PostPaint(ScRange(0, 0, 0, m_pDocument->MaxCol(), m_pDocument->MaxRow(), MAXTAB),
+                  PaintPartFlags::Grid | PaintPartFlags::Top | PaintPartFlags::Left);
+        SetDocumentModified();
+    }
+}
