+/// Ely: the default page style's text width, in twips.
+tools::Long lcl_ElyTextWidth(const SwDoc& rDoc)
+{
+    const SwFrameFormat& rPage = rDoc.GetPageDesc(0).GetMaster();
+    const SvxLRSpaceItem& rLR = rPage.GetLRSpace();
+    return rPage.GetFrameSize().GetWidth() - rLR.ResolveLeft({}) - rLR.ResolveRight({});
+}
+
+/// Ely: `rUrl`'s picture in a new paragraph, as a character.
+bool lcl_ElyInsertImage(SwDoc& rDoc, const OUString& rUrl, const OUString& rAfter, tools::Long nWidth)
+{
+    Graphic aGraphic;
+    if (GraphicFilter::LoadGraphic(rUrl, OUString(), aGraphic) != ERRCODE_NONE || aGraphic.IsNone())
+        return false;
+    const MapMode aTwip(MapUnit::MapTwip);
+    const MapMode aPref(aGraphic.GetPrefMapMode());
+    const Size aNatural = aPref.GetMapUnit() == MapUnit::MapPixel
+        ? Application::GetDefaultDevice()->PixelToLogic(aGraphic.GetPrefSize(), aTwip)
+        : OutputDevice::LogicToLogic(aGraphic.GetPrefSize(), aPref, aTwip);
+    if (aNatural.Width() <= 0 || aNatural.Height() <= 0)
+        return false;
+    // Natural size, no wider than the text unless asked.
+    const sal_Int64 nWide = nWidth > 0 ? nWidth : std::min<sal_Int64>(aNatural.Width(), lcl_ElyTextWidth(rDoc));
+    const sal_Int64 nHigh = std::max<sal_Int64>(1, sal_Int64(aNatural.Height()) * nWide / aNatural.Width());
+    SwNode* pBefore = rAfter.isEmpty() ? &rDoc.GetNodes().GetEndOfContent() : lcl_ElyAfterMatch(rDoc, rAfter);
+    if (!pBefore)
+        return false;
+    rDoc.GetIDocumentUndoRedo().StartUndo(SwUndoId::INSERT, nullptr);
+    SwPosition aPos(*pBefore, SwNodeOffset(-1));
+    rDoc.getIDocumentContentOperations().AppendTextNode(aPos);
+    rDoc.SetTextFormatColl(SwPaM(aPos), rDoc.getIDocumentStylePoolAccess().GetTextCollFromPool(RES_POOLCOLL_STANDARD), true, true);
+    SfxItemSetFixed<RES_FRMATR_BEGIN, RES_FRMATR_END - 1> aFly(rDoc.GetAttrPool());
+    aFly.Put(SwFormatAnchor(RndStdIds::FLY_AS_CHAR));
+    aFly.Put(SwFormatFrameSize(SwFrameSize::Fixed, nWide, nHigh));
+    const bool bDone = rDoc.getIDocumentContentOperations().InsertGraphic(SwPaM(aPos), OUString(), OUString(), &aGraphic, &aFly, nullptr, nullptr) != nullptr;
+    rDoc.GetIDocumentUndoRedo().EndUndo(SwUndoId::INSERT, nullptr);
+    return bDone;
+}
 }
 
