+/// Whether any paragraph lies between node indexes `nFrom` and `nTo`.
+static bool lcl_TextBetween(const SwNodes& rNodes, SwNodeOffset nFrom, SwNodeOffset nTo)
+{
+    for (SwNodeOffset n = nFrom + 1; n < nTo; ++n)
+        if (rNodes[n]->IsTextNode())
+            return true;
+    return false;
+}
+
+bool SwIncludedTextFits(const SwSectionNode& rSectNd)
+{
+    const SwStartNode* pBox = rSectNd.FindTableBoxStartNode();
+    if (!pBox)
+        return true;
+    // A cell opens and closes with its paragraphs.
+    const SwNodes& rNodes = rSectNd.GetNodes();
+    const bool bStarts = rNodes[rSectNd.GetIndex() + 1]->IsTextNode()
+                         || lcl_TextBetween(rNodes, pBox->GetIndex(), rSectNd.GetIndex());
+    const bool bEnds = rNodes[rSectNd.EndOfSectionIndex() - 1]->IsTextNode()
+                       || lcl_TextBetween(rNodes, rSectNd.EndOfSectionIndex(), pBox->EndOfSectionIndex());
+    return bStarts && bEnds;
+}
+
