+void MSWordExportBase::OutputIncludedEdge(const SwNode& rNode)
+{
+    const SwNodes& rNodes = rNode.GetNodes();
+    // Word holds the field's start and end in paragraphs.
+    if (const SwSectionNode* pSectNd = rNode.GetSectionNode())
+    {
+        if (IsIncludedText(*pSectNd) && !rNodes[rNode.GetIndex() + 1]->IsTextNode())
+            static_cast<DocxExport&>(*this).DocxAttrOutput().StartIncludeText(lcl_IncludeText(pSectNd->GetSection()));
+    }
+    else if (const SwSectionNode* pEnded = rNode.IsEndNode() ? rNode.StartOfSectionNode()->GetSectionNode() : nullptr)
+    {
+        if (IsIncludedText(*pEnded) && !rNodes[rNode.GetIndex() - 1]->IsTextNode())
+            static_cast<DocxExport&>(*this).DocxAttrOutput().EndIncludeText();
+    }
+}
