gpui: assistive positions follow the window's place on screen

X11's AT-SPI places nodes by the window's screen position, which was
sent once. It is sent again when assistive technology connects and
when the window moves or resizes.

diff --git a/vendor/gpui-pre/src/window.rs b/vendor/gpui-pre/src/window.rs
--- a/vendor/gpui-pre/src/window.rs
+++ b/vendor/gpui-pre/src/window.rs
@@ -1806,7 +1806,10 @@ impl Window {
                 .spawn(async move {
                     while activation_receiver.recv().await.is_ok() {
                         handle
-                            .update(&mut async_cx, |_, window, _| window.refresh())
+                            .update(&mut async_cx, |_, window, _| {
+                                window.platform_window.a11y_update_window_bounds();
+                                window.refresh()
+                            })
                             .with_context(|| {
                                 format!(
                                     "handling accessibility activation for window {:?}",
@@ -3004,6 +3007,8 @@ impl Window {
         self.scale_factor = self.platform_window.scale_factor();
         self.viewport_size = self.platform_window.content_size();
         self.mouse_position = self.platform_window.mouse_position();
+        // X11's AT-SPI places nodes by the window's screen position.
+        self.platform_window.a11y_update_window_bounds();
 
         self.refresh();
 
