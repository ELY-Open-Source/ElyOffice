gpui: the topmost window control wins the hit test

Window control areas were asked in paint order, so a title bar hit
before the caption button drawn on it. The hit test now walks the
hovered hitboxes from the top (Windows caption buttons).

diff --git a/vendor/gpui-pre/src/window.rs b/vendor/gpui-pre/src/window.rs
--- a/vendor/gpui-pre/src/window.rs
+++ b/vendor/gpui-pre/src/window.rs
@@ -2252,12 +2252,15 @@ impl Window {
             Box::new(move || {
                 handle
                     .update(&mut cx, |_, window, _cx| {
-                        for (area, hitbox) in &window.rendered_frame.window_control_hitboxes {
-                            if window.mouse_hit_test.ids.contains(&hitbox.id) {
-                                return Some(*area);
-                            }
-                        }
-                        None
+                        // Topmost first: a button wins over its bar.
+                        let areas = &window.rendered_frame.window_control_hitboxes;
+                        let hit = &window.mouse_hit_test;
+                        hit.ids.iter().take(hit.hover_hitbox_count).find_map(|id| {
+                            areas
+                                .iter()
+                                .find(|(_, hitbox)| hitbox.id == *id)
+                                .map(|(area, _)| *area)
+                        })
                     })
                     .with_context(|| {
