windows: no calls on a window Windows already destroyed

Dropping a window after WM_DESTROY hid and destroyed it again and left
a deferred activation report with no window to find.

diff --git a/vendor/gpui-pre-windows/src/events.rs b/vendor/gpui-pre-windows/src/events.rs
--- a/vendor/gpui-pre-windows/src/events.rs
+++ b/vendor/gpui-pre-windows/src/events.rs
@@ -323,6 +323,10 @@ impl WindowsWindowInner {
     }
 
     fn handle_destroy_msg(&self, handle: HWND) -> Option<isize> {
+        self.state.destroyed.set(true);
+        unsafe { windows::Win32::System::Ole::RevokeDragDrop(handle).log_err() };
+        // Its deferred report would find no window.
+        self.state.callbacks.active_status_change.take();
         let callback = { self.state.callbacks.close.take() };
         // Re-enable parent window if this was a modal dialog
         if let Some(parent_hwnd) = self.parent_hwnd {
